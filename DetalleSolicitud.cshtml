@{
    ViewData["Title"] = "Detalle de solicitud";

    // ------------------------------------------------------------------
    // Datos de vista (hardcoded para esta fase de alta fidelidad).
    // Nombrados pensando en un futuro DetalleSolicitudViewModel:
    //   Folio, Estaciones[], Asegurado, Paciente, Reclamacion.Partidas[]
    // Reutiliza el folio y los datos de la referencia oficial capturada
    // (Detalle_1 a Detalle_8) para mantener trazabilidad con la fuente.
    // ------------------------------------------------------------------
    var folio = "0100326135";

    var estaciones = new[] {
        new { Nombre = "Recepción de documentos", Estado = "hecho" },
        new { Nombre = "Dictamen administrativo",  Estado = "actual" },
        new { Nombre = "Autorización de pago",     Estado = "pendiente" },
        new { Nombre = "Pago autorizado",          Estado = "pendiente" },
    };
}

@section PageMessage {
    <div class="alert-page alert-page--warning" role="alert">
        <i data-lucide="alert-triangle" class="alert-page-icon" aria-hidden="true"></i>
        <div class="alert-page-body">
            <strong>Para proceder con la autorización</strong> es necesario ajustar los montos a pagar con base en las condiciones de indemnización.
            <a href="#" class="alert-page-link">Consultar sugerencias por cobertura</a>
        </div>
    </div>
}

<div class="solicitud-view">

    @* =================================================================
       Encabezado del folio + timeline de estaciones
       ================================================================= *@
    <div class="folio-head">
        <div class="folio-head-main">
            <span class="folio-eyebrow">Solicitud de reembolso</span>
            <h1 class="folio-title">Folio: @folio</h1>

            <div class="stage-timeline" role="list" aria-label="Estaciones del trámite">
                @for (int i = 0; i < estaciones.Length; i++)
                {
                    var e = estaciones[i];
                    <div class="stage-step @(e.Estado == "hecho" ? "is-done" : "") @(e.Estado == "actual" ? "is-current" : "")" role="listitem">
                        <span class="stage-dot" aria-hidden="true">
                            @if (e.Estado == "hecho")
                            {
                                <i data-lucide="check" aria-hidden="true"></i>
                            }
                            else
                            {
                                <span>@(i + 1)</span>
                            }
                        </span>
                        <span class="stage-label">@e.Nombre</span>
                    </div>
                    if (i < estaciones.Length - 1)
                    {
                        <span class="stage-connector" aria-hidden="true"></span>
                    }
                }
            </div>
        </div>

        <div class="folio-head-actions">
            <button type="button" class="doc-gen-btn doc-gen-btn--secondary" data-bs-toggle="modal" data-bs-target="#modalSaldoDetalle">
                <i data-lucide="wallet" aria-hidden="true"></i> Conoce tu saldo
            </button>
        </div>
    </div>

    @* =================================================================
       Datos del asegurado titular (solo lectura) + Notas del trámite
       Fila combinada: únicamente esta sección comparte ancho con el aside
       de notas (máx. 1/4 del ancho total). El resto de la vista conserva
       el ancho completo, sin cambios.
       ================================================================= *@
    <div class="asegurado-notes-row">
        <div class="asegurado-notes-main">
            <section class="form-section" aria-label="Datos del asegurado titular">
                <div class="form-section-header" style="cursor:default">
                    <span class="form-section-title">Datos del asegurado titular</span>
                </div>
                <div class="form-section-body">
                    <div class="field-grid">
                        <div class="field"><span class="field-label">Número de empleado</span><span class="field-readonly-value">32153358</span></div>
                        <div class="field"><span class="field-label">Titular</span><span class="field-readonly-value">Héctor Ceballos Pérez</span></div>
                        <div class="field"><span class="field-label">Grupo</span><span class="field-readonly-value">17000003</span></div>
                        <div class="field"><span class="field-label">Correo</span><span class="field-readonly-value">jmjimenez@bupa.com.mx</span></div>
                    </div>
                    <div class="field-grid">
                        <div class="field"><span class="field-label">Número telefónico</span><span class="field-readonly-value">12 3456 7876</span></div>
                        <div class="field"><span class="field-label">Fecha inicio vigencia</span><span class="field-readonly-value">03/01/2026</span></div>
                        <div class="field"><span class="field-label">Fecha fin vigencia</span><span class="field-readonly-value">31/12/2199</span></div>
                        <div class="field"><span class="field-label">Miembro desde</span><span class="field-readonly-value">03/01/2026</span></div>
                    </div>
                </div>
            </section>

            @* =================================================================
               Datos del paciente o derechohabiente (solo lectura)
               ================================================================= *@
            <section class="form-section" aria-label="Datos del paciente o derechohabiente">
                <div class="form-section-header" style="cursor:default">
                    <span class="form-section-title">Datos del paciente o derechohabiente</span>
                </div>
                <div class="form-section-body">
                    <div class="field-grid">
                        <div class="field"><span class="field-label">Nombre del paciente</span><span class="field-readonly-value">Héctor Ceballos Pérez</span></div>
                        <div class="field"><span class="field-label">Parentesco</span><span class="field-readonly-value">Titular</span></div>
                        <div class="field"><span class="field-label">Fecha de servicio</span><span class="field-readonly-value">15/05/2026</span></div>
                        <div class="field"><span class="field-label">Edad</span><span class="field-readonly-value">39 años</span></div>
                    </div>
                    <div class="field-grid">
                        <div class="field"><span class="field-label">Estado</span><span class="field-readonly-value">Puebla</span></div>
                        <div class="field"><span class="field-label">Municipio</span><span class="field-readonly-value">Chapulco</span></div>
                    </div>
                </div>
            </section>
        </div>

        <aside class="solicitud-notes-panel" id="panelNotasDetalle" aria-label="Notas del trámite">
            <div class="notes-panel-header">
                <i data-lucide="message-square" aria-hidden="true"></i>
                <h2 class="notes-panel-title">Notas del trámite</h2>
                <span class="notes-panel-badge">1</span>
            </div>

            <div class="note-add">
                <label class="field-label" for="notaNuevoTexto">Agregar nota</label>
                <div class="note-add-row">
                    <input type="text" id="notaNuevoTexto" class="form-control note-add-input" placeholder="Escribe una nota sobre este trámite">
                    <button type="button" id="btnAgregarNotaDetalle" class="note-add-btn" title="Agregar nota" aria-label="Agregar nota">
                        <i data-lucide="plus" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <ul class="note-timeline" data-note-timeline>
                <li class="note-item">
                    <span class="note-icon"><i data-lucide="alert-triangle" aria-hidden="true"></i></span>
                    <div class="note-body">
                        <p class="note-text">Se requiere ajustar el monto autorizado conforme a las condiciones de indemnización de la cobertura de gastos en el extranjero.</p>
                        <span class="note-meta">Ana López · Analista de Dictamen · 06/07/2026, 4:10 p. m.</span>
                    </div>
                </li>
            </ul>
        </aside>
    </div>

    @* =================================================================
       Datos de la reclamación
       ================================================================= *@
    <section class="form-section" aria-label="Datos de la reclamación">
        <div class="form-section-header" style="cursor:default">
            <span class="form-section-title">Datos de la reclamación</span>
        </div>
        <div class="form-section-body">

            <div class="section-toolbar">
                <div class="section-toolbar-actions">
                    <button type="button" class="doc-gen-btn doc-gen-btn--secondary" data-icd-open data-icd-prefill="false">
                        <i data-lucide="stethoscope" aria-hidden="true"></i> ICD / CPT
                    </button>
                    <button type="button" class="doc-gen-btn doc-gen-btn--secondary" data-historico-icd-open>
                        <i data-lucide="history" aria-hidden="true"></i> Histórico ICD
                    </button>
                </div>
                <a href="#" class="pdf-link">
                    <i data-lucide="file-text" aria-hidden="true"></i> Formato de instrucción de reembolso
                </a>
            </div>

            <span class="category-chip"><i data-lucide="plane" aria-hidden="true"></i> Gastos en el extranjero</span>

            @* ---- FACTURA ---- *@
            <div class="doc-block">
                <button type="button" class="doc-block-header" data-doc-toggle aria-expanded="true" aria-controls="bodyFactura">
                    <span class="doc-block-name">Factura</span>
                    <span class="doc-block-total">Total: 1 · Monto: $60,000.00</span>
                    <i data-lucide="chevron-down" class="doc-block-chevron" aria-hidden="true"></i>
                </button>
                <div id="bodyFactura" class="doc-block-body">
                    <div class="claim-table-scroll">
                        <table class="claim-table">
                            <thead>
                                <tr>
                                    <th>Concepto</th>
                                    <th class="ta-center">Procedente</th>
                                    <th>Observaciones</th>
                                    <th>Fecha servicio</th>
                                    <th class="ta-right">Reclamado (origen)</th>
                                    <th class="ta-right">Conversión USD</th>
                                    <th class="ta-right">Conversión MXN</th>
                                    <th class="ta-right">Autorizado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <button type="button" class="icd-btn" data-icd-open data-icd-prefill="true">
                                            <i data-lucide="tag" aria-hidden="true"></i> ICD/CPT
                                        </button>
                                        <div style="margin-top:6px;font-weight:600">Gastos en el extranjero</div>
                                    </td>
                                    <td class="ta-center">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input class="form-check-input" type="checkbox" role="switch" id="procedenteFactura" checked
                                                   data-procedente-switch="obsFactura" style="width:2.4em;height:1.3em">
                                        </div>
                                    </td>
                                    <td><input type="text" id="obsFactura" class="form-control form-control-sm" placeholder="Motivo si no procede"></td>
                                    <td>21/06/2026</td>
                                    <td class="ta-right">$60,000.00</td>
                                    <td class="ta-right">$0.00</td>
                                    <td class="ta-right">$0.00</td>
                                    <td class="ta-right"><input type="text" class="form-control form-control-sm autorizado-input" value="$58,500.00"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* ---- INFORME MÉDICO ---- *@
            <div class="doc-block">
                <button type="button" class="doc-block-header" data-doc-toggle aria-expanded="false" aria-controls="bodyInforme">
                    <span class="doc-block-name">Informe médico</span>
                    <span class="doc-block-total">Total: 1</span>
                    <i data-lucide="chevron-down" class="doc-block-chevron" aria-hidden="true"></i>
                </button>
                <div id="bodyInforme" class="doc-block-body" hidden>
                    <div class="claim-table-scroll">
                        <table class="claim-table">
                            <thead>
                                <tr>
                                    <th>Documento</th>
                                    <th class="ta-center">Procedente</th>
                                    <th>Observaciones</th>
                                    <th class="ta-center">Vista previa</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Imagen (1)</td>
                                    <td class="ta-center">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input class="form-check-input" type="checkbox" role="switch" id="procedenteInforme" checked
                                                   data-procedente-switch="obsInforme" style="width:2.4em;height:1.3em">
                                        </div>
                                    </td>
                                    <td><input type="text" id="obsInforme" class="form-control form-control-sm" placeholder="Motivo si no procede"></td>
                                    <td class="ta-center">
                                        <button type="button" class="thumb-btn" title="Ver imagen adjunta" aria-label="Ver imagen adjunta del informe médico">
                                            <i data-lucide="image" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="summary-figures">
                <div class="summary-figure">
                    <span class="summary-figure-label">Monto disponible cobertura</span>
                    <span class="summary-figure-value">$30,000.00 MXN</span>
                </div>
                <div class="summary-figure">
                    <span class="summary-figure-label">Monto disponible póliza</span>
                    <span class="summary-figure-value">$30,000.00 MXN</span>
                </div>
            </div>
        </div>
    </section>

    @* =================================================================
       Evidencias — reutiliza el patrón .doc-file-row / .doc-file-add ya
       construido para Solicitud.cshtml (misma clase, mismo comportamiento).
       ================================================================= *@
    <section class="form-section" aria-label="Evidencias">
        <div class="form-section-header" style="cursor:default">
            <span class="form-section-title">Evidencias</span>
        </div>
        <div class="form-section-body">
            <div id="filasEvidencias">
                <div class="doc-file-row">
                    <input type="text" class="form-control doc-file-input" readonly placeholder="Evidencia (PNG, JPEG o PDF, máx. 5 MB)">
                    <button type="button" class="doc-gen-btn doc-gen-btn--secondary" style="min-height:44px">
                        <i data-lucide="upload" aria-hidden="true"></i> Cargar
                    </button>
                    <button type="button" class="doc-file-remove" title="Quitar evidencia" aria-label="Quitar evidencia" style="display:none">
                        <i data-lucide="trash-2" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <button type="button" class="doc-file-add" data-doc-add="filasEvidencias">
                <i data-lucide="plus-circle" aria-hidden="true"></i> Agregar otra evidencia
            </button>
        </div>
    </section>

    <div class="field">
        <label class="field-label" for="textareaComentariosDetalle">Comentarios</label>
        <textarea id="textareaComentariosDetalle" class="form-control" rows="4" placeholder="Agrega observaciones sobre el dictamen de esta solicitud"></textarea>
    </div>

    @* =================================================================
       Acciones disponibles
       ================================================================= *@
    <div class="detalle-actions">
        <div class="detalle-actions-left">
            <button type="button" class="btn-danger-outline-vm">
                <i data-lucide="ban" aria-hidden="true"></i> Rechazar trámite
            </button>
            <div class="siniestro-tag">
                <span class="siniestro-tag-label">Siniestro</span>
                <span class="siniestro-tag-value">Accidente</span>
            </div>
        </div>
        <div class="detalle-actions-right">
            <a href="#" class="icon-btn" title="Volver al tablero" aria-label="Volver al tablero">
                <i data-lucide="arrow-left" aria-hidden="true"></i>
            </a>
            <button type="button" class="btn btn-primary">
                Siguiente <i data-lucide="arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

@* =====================================================================
