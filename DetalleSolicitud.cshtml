@* =====================================================================
   Modal · ICD / CPT
   ===================================================================== *@
<div class="modal fade" id="modalIcd" tabindex="-1" aria-labelledby="modalIcdLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="modalIcdLabel">Diagnóstico / Tratamiento</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="icd-modal-field field">
                    <label class="field-label" for="icdCodigo">ICD</label>
                    <input type="text" id="icdCodigo" class="form-control" placeholder="Ej. Z719">
                </div>
                <div class="icd-modal-field field">
                    <label class="field-label" for="icdDescripcion">Descripción</label>
                    <input type="text" id="icdDescripcion" class="form-control" placeholder="Descripción del diagnóstico">
                </div>
                <div class="icd-modal-field field">
                    <label class="field-label" for="cptCodigo">CPT</label>
                    <input type="text" id="cptCodigo" class="form-control" placeholder="Ej. L7999FE">
                </div>
                <div class="icd-modal-field field">
                    <label class="field-label" for="cptDescripcion">Descripción</label>
                    <input type="text" id="cptDescripcion" class="form-control" placeholder="Descripción del tratamiento">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-text-vm" data-icd-limpiar>Limpiar</button>
                <button type="button" class="btn-primary-vm" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@* =====================================================================
   Modal · Histórico ICD
   ===================================================================== *@
<div class="modal fade" id="modalHistoricoIcd" tabindex="-1" aria-labelledby="modalHistoricoIcdLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="modalHistoricoIcdLabel">Histórico ICD</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="claim-table-scroll">
                    <table class="claim-table">
                        <thead>
                            <tr><th>Folio</th><th>Motivo</th><th>Concepto</th><th>DX</th></tr>
                        </thead>
                        <tbody data-historico-body></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/reembolso-solicitud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/detalle-solicitud.css" asp-append-version="true" />
}

@section Scripts {
    @* Se reutiliza el script de Solicitud: initDocBlocks (acordeón interno) e
       initDocBlocks/doc-file-add (agregar/quitar evidencias) son genéricos y
       ya cubren esta pantalla — evita duplicar la misma lógica. *@
    <script src="~/js/reembolso-solicitud.js" asp-append-version="true"></script>
    <script src="~/js/detalle-solicitud.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(function (el) {
        new bootstrap.Popover(el);
        });
        });
    </script>
}
