<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Angular Lazy Loading con Rutas</Title>
      <Author>VS2026 Snippets Library</Author>
      <Description>Feature module Angular 19+ con lazy loading, guards funcionales, resolvers tipados y child routes.</Description>
      <Shortcut>angular-intermediate-lazy-routing</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>FeatureName</ID>
          <ToolTip>Nombre del módulo feature (ej: Products)</ToolTip>
          <Default>Products</Default>
        </Literal>
        <Literal>
          <ID>RoutePath</ID>
          <ToolTip>Ruta del segmento URL (ej: products)</ToolTip>
          <Default>products</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript">
        <![CDATA[// ============================================================
// app.routes.ts — Rutas principales con lazy loading
// ============================================================
import { Routes } from '@angular/router';
import { authGuard } from './guards/auth.guard';

export const APP_ROUTES: Routes = [
  {
    path: '',
    redirectTo: 'dashboard',
    pathMatch: 'full',
  },
  {
    path: 'dashboard',
    loadComponent: () =>
      import('./features/dashboard/dashboard.component').then(
        (m) => m.DashboardComponent
      ),
    title: 'Dashboard',
  },
  {
    path: '$RoutePath$',
    loadChildren: () =>
      import('./features/$RoutePath$/$RoutePath$.routes').then(
        (m) => m.$FeatureName$_ROUTES
      ),
    canActivate: [authGuard],
    title: '$FeatureName$',
  },
  {
    path: '**',
    loadComponent: () =>
      import('./shared/not-found/not-found.component').then(
        (m) => m.NotFoundComponent
      ),
    title: 'Página no encontrada',
  },
];

// ============================================================
// $RoutePath$.routes.ts — Child routes del feature
// ============================================================
import { Routes } from '@angular/router';
import { $FeatureName$Resolver } from './$RoutePath$.resolver';

export const $FeatureName$_ROUTES: Routes = [
  {
    path: '',
    loadComponent: () =>
      import('./$RoutePath$-list/$RoutePath$-list.component').then(
        (m) => m.$FeatureName$ListComponent
      ),
    title: 'Lista de $FeatureName$',
  },
  {
    path: 'nuevo',
    loadComponent: () =>
      import('./$RoutePath$-form/$RoutePath$-form.component').then(
        (m) => m.$FeatureName$FormComponent
      ),
    title: 'Nuevo $FeatureName$',
  },
  {
    path: ':id',
    resolve: { item: $FeatureName$Resolver },
    loadComponent: () =>
      import('./$RoutePath$-detail/$RoutePath$-detail.component').then(
        (m) => m.$FeatureName$DetailComponent
      ),
    title: 'Detalle de $FeatureName$',
  },
  {
    path: ':id/editar',
    resolve: { item: $FeatureName$Resolver },
    loadComponent: () =>
      import('./$RoutePath$-form/$RoutePath$-form.component').then(
        (m) => m.$FeatureName$FormComponent
      ),
    title: 'Editar $FeatureName$',
  },
];

// ============================================================
// auth.guard.ts — Guard funcional
// ============================================================
import { inject } from '@angular/core';
import { CanActivateFn, Router } from '@angular/router';
import { AuthService } from '../services/auth.service';

export const authGuard: CanActivateFn = (_route, state) => {
  const auth = inject(AuthService);
  const router = inject(Router);

  if (auth.isAuthenticated()) return true;

  return router.createUrlTree(['/login'], {
    queryParams: { returnUrl: state.url },
  });
};

// ============================================================
// $RoutePath$.resolver.ts — Resolver tipado funcional
// ============================================================
import { ResolveFn, ActivatedRouteSnapshot } from '@angular/router';
import { inject } from '@angular/core';
import { $FeatureName$Service } from './$RoutePath$.service';

export interface $FeatureName$Item {
  id: number;
  name: string;
  description: string;
  isActive: boolean;
  createdAt: string;
}

export const $FeatureName$Resolver: ResolveFn<$FeatureName$Item | null> = async (
  route: ActivatedRouteSnapshot
) => {
  const service = inject($FeatureName$Service);
  const id = Number(route.paramMap.get('id'));

  if (isNaN(id) || id <= 0) return null;

  try {
    return await service.findById(id);
  } catch {
    return null;
  }
};

// ============================================================
// $FeatureName$ListComponent — Componente de lista
// ============================================================
import {
  Component,
  OnInit,
  inject,
  signal,
  computed,
  ChangeDetectionStrategy,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterModule } from '@angular/router';
import { $FeatureName$Service } from './$RoutePath$.service';

@Component({
  selector: 'app-$RoutePath$-list',
  standalone: true,
  imports: [CommonModule, RouterModule],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <main class="container py-4">
      <header class="d-flex justify-content-between align-items-center mb-4">
        <h1>$FeatureName$</h1>
        <a
          routerLink="nuevo"
          class="btn btn-primary"
          aria-label="Crear nuevo registro">
          + Nuevo
        </a>
      </header>

      @if (service.loading()) {
        <div class="d-flex justify-content-center py-5" aria-busy="true" role="status">
          <div class="spinner-border text-primary" aria-hidden="true"></div>
          <span class="visually-hidden">Cargando...</span>
        </div>
      } @else if (service.error()) {
        <div class="alert alert-danger" role="alert">{{ service.error() }}</div>
      } @else if (service.isEmpty()) {
        <div class="text-center py-5 text-muted">
          <p>No hay registros disponibles.</p>
          <a routerLink="nuevo" class="btn btn-outline-primary">Crear primero</a>
        </div>
      } @else {
        <ul class="list-group" role="list" aria-label="Lista de $FeatureName$">
          @for (item of service.items(); track item.id) {
            <li class="list-group-item d-flex justify-content-between align-items-center" role="listitem">
              <div>
                <strong>{{ item.name }}</strong>
                <small class="text-muted d-block">{{ item.description }}</small>
              </div>
              <div class="d-flex gap-2">
                <a
                  [routerLink]="[item.id]"
                  class="btn btn-sm btn-outline-secondary"
                  [attr.aria-label]="'Ver detalle de ' + item.name">
                  Ver
                </a>
                <a
                  [routerLink]="[item.id, 'editar']"
                  class="btn btn-sm btn-outline-primary"
                  [attr.aria-label]="'Editar ' + item.name">
                  Editar
                </a>
                <button
                  type="button"
                  class="btn btn-sm btn-outline-danger"
                  (click)="onDelete(item.id, item.name)"
                  [attr.aria-label]="'Eliminar ' + item.name">
                  Eliminar
                </button>
              </div>
            </li>
          }
        </ul>
      }
    </main>
  `,
})
export class $FeatureName$ListComponent implements OnInit {
  protected readonly service = inject($FeatureName$Service);

  ngOnInit(): void {
    this.service.loadAll({ page: 1, pageSize: 20 });
  }

  onDelete(id: number, name: string): void {
    if (confirm(`¿Eliminar "${name}"? Esta acción no se puede deshacer.`)) {
      this.service.delete(id);
    }
  }
}

// ============================================================
// $FeatureName$Service (placeholder — usar angular-basic-service)
// ============================================================
@Injectable({ providedIn: 'root' })
class $FeatureName$Service {
  readonly items = signal<$FeatureName$Item[]>([]);
  readonly loading = signal(false);
  readonly error = signal<string | null>(null);
  readonly isEmpty = computed(() => !this.loading() && this.items().length === 0);

  loadAll(_params: Record<string, unknown>): void { /* implementar */ }
  delete(_id: number): void { /* implementar */ }
  async findById(_id: number): Promise<$FeatureName$Item | null> { return null; }
}
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
