<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Angular Standalone Component con Signals</Title>
      <Author>VS2026 Snippets Library</Author>
      <Description>Componente standalone Angular 19+ con Signals, computed, effect, input/output signal API y template moderno.</Description>
      <Shortcut>angular-basic-standalone</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ComponentName</ID>
          <ToolTip>Nombre del componente en PascalCase (ej: UserCard)</ToolTip>
          <Default>UserCard</Default>
        </Literal>
        <Literal>
          <ID>Selector</ID>
          <ToolTip>Selector CSS del componente (ej: app-user-card)</ToolTip>
          <Default>app-user-card</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript">
        <![CDATA[// $ComponentName$.component.ts
import {
  Component,
  signal,
  computed,
  effect,
  input,
  output,
  inject,
  ChangeDetectionStrategy,
  OnInit,
} from '@angular/core';
import { CommonModule } from '@angular/common';
import { RouterModule } from '@angular/router';

// ---- Modelo de datos ----
export interface $ComponentName$Data {
  id: number;
  name: string;
  description: string;
  isActive: boolean;
}

@Component({
  selector: '$Selector$',
  standalone: true,
  imports: [CommonModule, RouterModule],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <!-- $ComponentName$ — WCAG 2.2 AA -->
    <article
      class="card"
      [class.card--inactive]="!item()?.isActive"
      [attr.aria-label]="item()?.name ?? 'Cargando...'"
      role="article">

      @if (loading()) {
        <div class="card__skeleton" aria-busy="true" aria-label="Cargando contenido">
          <div class="skeleton skeleton--title"></div>
          <div class="skeleton skeleton--text"></div>
        </div>
      } @else if (error()) {
        <div class="card__error" role="alert" aria-live="assertive">
          <p>{{ error() }}</p>
          <button type="button" (click)="retry.emit()">Reintentar</button>
        </div>
      } @else if (item()) {
        <div class="card__body">
          <h2 class="card__title" [id]="'title-' + item()!.id">
            {{ item()!.name }}
          </h2>
          <p class="card__description" [attr.aria-labelledby]="'title-' + item()!.id">
            {{ item()!.description }}
          </p>

          <span
            class="badge"
            [class.badge--active]="item()!.isActive"
            [attr.aria-label]="statusLabel()">
            {{ statusLabel() }}
          </span>
        </div>

        <footer class="card__footer">
          <button
            type="button"
            class="btn btn--primary"
            (click)="onEdit()"
            [attr.aria-label]="'Editar ' + item()!.name">
            Editar
          </button>
          <button
            type="button"
            class="btn btn--danger"
            (click)="onDelete()"
            [attr.aria-label]="'Eliminar ' + item()!.name">
            Eliminar
          </button>
        </footer>
      }
    </article>
  `,
  styles: [`
    .card {
      border: 1px solid #dee2e6;
      border-radius: 0.5rem;
      padding: 1.25rem;
      background: #fff;
      transition: box-shadow 0.2s;
    }
    .card--inactive { opacity: 0.6; }
    .card__title { font-size: 1.125rem; margin: 0 0 0.5rem; }
    .card__description { color: #6c757d; margin: 0 0 1rem; }
    .card__footer { display: flex; gap: 0.5rem; }
    .badge { padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.75rem; }
    .badge--active { background: #d1fae5; color: #065f46; }
    .btn { padding: 0.5rem 1rem; border: none; border-radius: 0.375rem; cursor: pointer; }
    .btn--primary { background: #3b82f6; color: #fff; }
    .btn--danger { background: #ef4444; color: #fff; }
    .skeleton { background: #e5e7eb; border-radius: 0.25rem; margin-bottom: 0.5rem; }
    .skeleton--title { height: 1.25rem; width: 60%; }
    .skeleton--text { height: 1rem; width: 90%; }
  `],
})
export class $ComponentName$Component implements OnInit {
  // ---- Signal inputs (Angular 17.1+) ----
  item = input<$ComponentName$Data | null>(null);
  loading = input<boolean>(false);
  error = input<string | null>(null);

  // ---- Signal outputs ----
  edit = output<$ComponentName$Data>();
  delete = output<number>();
  retry = output<void>();

  // ---- Computed signals ----
  statusLabel = computed(() =>
    this.item()?.isActive ? 'Activo' : 'Inactivo'
  );

  // ---- Effect: reacciona a cambios ----
  private readonly logEffect = effect(() => {
    if (this.item()) {
      // Efecto secundario al cambiar el item
      console.debug(`[$ComponentName$] Item actualizado:`, this.item()?.name);
    }
  });

  ngOnInit(): void {
    // Inicialización del componente
  }

  onEdit(): void {
    const current = this.item();
    if (current) this.edit.emit(current);
  }

  onDelete(): void {
    const current = this.item();
    if (current && confirm(`¿Eliminar "${current.name}"?`)) {
      this.delete.emit(current.id);
    }
  }
}
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
