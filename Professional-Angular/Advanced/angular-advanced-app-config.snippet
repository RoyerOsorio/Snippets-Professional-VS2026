<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Angular App Config y Bootstrap Completo</Title>
      <Author>VS2026 Snippets Library</Author>
      <Description>Configuración completa de aplicación Angular 19+ standalone: app.config.ts, main.ts, environment, error handler global y providers empresariales.</Description>
      <Shortcut>angular-advanced-app-config</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>AppTitle</ID>
          <ToolTip>Título de la aplicación (ej: MiApp)</ToolTip>
          <Default>MiApp</Default>
        </Literal>
        <Literal>
          <ID>ApiBaseUrl</ID>
          <ToolTip>URL base de la API (ej: https://api.miapp.com)</ToolTip>
          <Default>https://api.miapp.com</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript">
        <![CDATA[// ============================================================
// environments/environment.ts
// ============================================================
export const environment = {
  production: false,
  apiUrl: 'http://localhost:5000/api',
  appTitle: '$AppTitle$',
  version: '1.0.0',
  featureFlags: {
    enableAnalytics: false,
    enableBetaFeatures: false,
  },
};

// environments/environment.prod.ts
export const environment = {
  production: true,
  apiUrl: '$ApiBaseUrl$',
  appTitle: '$AppTitle$',
  version: '1.0.0',
  featureFlags: {
    enableAnalytics: true,
    enableBetaFeatures: false,
  },
};

// ============================================================
// global-error-handler.ts
// ============================================================
import { ErrorHandler, Injectable, inject } from '@angular/core';

@Injectable()
export class GlobalErrorHandler implements ErrorHandler {
  handleError(error: unknown): void {
    // Reemplazar con tu servicio de monitoreo (Sentry, DataDog, etc.)
    const message = error instanceof Error ? error.message : String(error);
    console.error('[GlobalErrorHandler]', message, error);

    // Ejemplo: reportar a API de monitoreo
    // this.monitoringService.captureError(error);
  }
}

// ============================================================
// app.config.ts — Configuración principal de la aplicación
// ============================================================
import {
  ApplicationConfig,
  provideZoneChangeDetection,
  ErrorHandler,
  isDevMode,
} from '@angular/core';
import { provideRouter, withPreloading, PreloadAllModules, withComponentInputBinding, withViewTransitions } from '@angular/router';
import { provideHttpClient, withInterceptors, withFetch } from '@angular/common/http';
import { provideAnimations } from '@angular/platform-browser/animations';
import { APP_ROUTES } from './app.routes';
import { authInterceptor } from './interceptors/auth.interceptor';

export const appConfig: ApplicationConfig = {
  providers: [
    // ---- Detección de cambios optimizada ----
    provideZoneChangeDetection({ eventCoalescing: true }),

    // ---- Router ----
    provideRouter(
      APP_ROUTES,
      withPreloading(PreloadAllModules),   // Precarga lazy modules
      withComponentInputBinding(),          // Bind route params a @Input
      withViewTransitions()                 // View Transitions API
    ),

    // ---- HTTP con interceptores ----
    provideHttpClient(
      withFetch(),                          // Usa fetch API nativa
      withInterceptors([authInterceptor])
    ),

    // ---- Animaciones ----
    provideAnimations(),

    // ---- Error handler global ----
    { provide: ErrorHandler, useClass: GlobalErrorHandler },

    // ---- Otros providers aquí ----
    // { provide: APP_INITIALIZER, useFactory: appInitializer, deps: [ConfigService], multi: true },
    // { provide: LOCALE_ID, useValue: 'es-MX' },
  ],
};

// ============================================================
// main.ts — Bootstrap de la aplicación
// ============================================================
import { bootstrapApplication } from '@angular/platform-browser';
import { AppComponent } from './app/app.component';
import { appConfig } from './app/app.config';

bootstrapApplication(AppComponent, appConfig).catch((err) =>
  console.error('[Bootstrap Error]', err)
);

// ============================================================
// app.component.ts — Componente raíz
// ============================================================
import {
  Component,
  inject,
  OnInit,
  ChangeDetectionStrategy,
} from '@angular/core';
import { RouterOutlet, RouterModule } from '@angular/router';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-root',
  standalone: true,
  imports: [CommonModule, RouterOutlet, RouterModule],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <a
      href="#main-content"
      class="skip-link"
      aria-label="Saltar al contenido principal">
      Saltar al contenido
    </a>

    <header role="banner">
      <nav role="navigation" aria-label="Navegación principal">
        <a routerLink="/" class="brand" aria-label="Inicio $AppTitle$">
          $AppTitle$
        </a>
        <ul role="list">
          <li><a routerLink="/dashboard" routerLinkActive="active">Dashboard</a></li>
        </ul>
      </nav>
    </header>

    <main id="main-content" role="main" tabindex="-1">
      <router-outlet />
    </main>

    <footer role="contentinfo">
      <p>&copy; {{ year }} $AppTitle$. Todos los derechos reservados.</p>
    </footer>
  `,
  styles: [`
    .skip-link {
      position: absolute;
      top: -100%;
      left: 1rem;
      background: #000;
      color: #fff;
      padding: 0.5rem 1rem;
      border-radius: 0 0 0.25rem 0.25rem;
      z-index: 9999;
      transition: top 0.2s;
    }
    .skip-link:focus { top: 0; }
    header { background: #212529; color: #fff; padding: 0 1.5rem; }
    nav { display: flex; align-items: center; gap: 2rem; height: 60px; }
    .brand { color: #fff; font-weight: 700; text-decoration: none; }
    nav ul { list-style: none; display: flex; gap: 1rem; margin: 0; padding: 0; }
    nav a { color: #adb5bd; text-decoration: none; }
    nav a.active, nav a:hover { color: #fff; }
    main { min-height: calc(100vh - 120px); padding: 1.5rem; }
    footer { background: #f8f9fa; text-align: center; padding: 1rem; color: #6c757d; }
  `],
})
export class AppComponent implements OnInit {
  protected readonly year = new Date().getFullYear();

  ngOnInit(): void {
    // Inicialización global (analytics, i18n, etc.)
  }
}
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
