<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Razor Basic Model Binding</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Vista Razor con model binding, Html.DisplayFor, Html.EditorFor, ValidationMessageFor y tag helpers básicos</Description>
      <Shortcut>razor-basic-model</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ModelType</ID><ToolTip>Tipo del modelo de la vista</ToolTip><Default>ProductoViewModel</Default>
        </Literal>
        <Literal>
          <ID>controllerName</ID><ToolTip>Nombre del controlador (sin "Controller")</ToolTip><Default>Productos</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[@model $ModelType$

@{
    ViewData["Title"] = "Detalle de " + Model?.Nombre ?? "Producto";
    var isEdit = Model?.Id > 0;
}

<div class="container py-4">

    <!-- Encabezado de página con breadcrumb -->
    <nav aria-label="Ruta de navegación" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="$controllerName$" asp-action="Index">@ViewData["Title"]</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                @(isEdit ? "Editar" : "Nuevo")
            </li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent">
                    <h1 class="h4 mb-0">
                        @(isEdit ? "Editar" : "Nuevo") @typeof($ModelType$).Name
                    </h1>
                </div>

                <div class="card-body">
                    <!-- Resumen de errores de validación -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"
                         aria-live="polite">
                    </div>

                    <form asp-controller="$controllerName$"
                          asp-action="@(isEdit ? "Edit" : "Create")"
                          method="post"
                          id="mainForm">

                        @* Token anti-falsificación *@
                        @Html.AntiForgeryToken()

                        @* ID oculto en modo edición *@
                        @if (isEdit)
                        {
                            <input asp-for="Id" type="hidden" />
                        }

                        <!-- Campo: Nombre -->
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Ingresa el nombre..."
                                   autocomplete="off" />
                            <span asp-validation-for="Nombre"
                                  class="invalid-feedback d-block"
                                  role="alert"></span>
                        </div>

                        <!-- Campo: Descripción -->
                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Descripción del elemento..."></textarea>
                            <span asp-validation-for="Descripcion" class="invalid-feedback d-block" role="alert"></span>
                        </div>

                        <!-- Campo: Precio (numérico) -->
                        <div class="mb-4">
                            <label asp-for="Precio" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text" aria-hidden="true">$</span>
                                <input asp-for="Precio"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0" />
                            </div>
                            <span asp-validation-for="Precio" class="invalid-feedback d-block" role="alert"></span>
                        </div>

                        <!-- Acciones -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-controller="$controllerName$"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                @(isEdit ? "Actualizar" : "Guardar")
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Deshabilitar doble envío
        document.getElementById('mainForm')?.addEventListener('submit', function (e) {
            const btn = document.getElementById('submitBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
            }
        });
    </script>
    $end$
}]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
