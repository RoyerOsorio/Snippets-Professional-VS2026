<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Razor Basic Layout</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Archivo _Layout.cshtml completo con Bootstrap 5.3.3, navbar, RenderBody, secciones y partial views</Description>
      <Shortcut>razor-basic-layout</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>appName</ID><ToolTip>Nombre de la aplicación</ToolTip><Default>Mi Aplicación</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!DOCTYPE html>
<html lang="es" data-bs-theme="auto">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - $appName$</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Descripción por defecto de la aplicación.")" />

    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyApp.styles.css" asp-append-version="true" />

    <!-- Sección para CSS adicionales por vista -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Skip link de accesibilidad -->
    <a href="#main-content" class="visually-hidden-focusable btn btn-primary position-absolute top-0 start-50 translate-middle-x mt-2" style="z-index:9999;">
        Saltar al contenido principal
    </a>

    <!-- Navbar parcial -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3"
             aria-label="Navegación principal">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">$appName$</a>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Alternar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarNav">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                    </ul>
                    <!-- Partial de autenticación -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <div class="container">
        <main id="main-content" role="main" tabindex="-1" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <span>&copy; <time datetime="2026">2026</time> $appName$. Todos los derechos reservados.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Política de Privacidad</a>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sección para scripts adicionales por vista -->
    @await RenderSectionAsync("Scripts", required: false)
    $end$
</body>
</html>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
