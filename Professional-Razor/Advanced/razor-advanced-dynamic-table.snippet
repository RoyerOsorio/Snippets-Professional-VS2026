<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Razor Advanced Dynamic Table with Pagination</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Tabla Razor dinámica con paginación server-side, ordenamiento, búsqueda, exportar y ARIA completo</Description>
      <Shortcut>razor-advanced-dynamic-table</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ModelType</ID><ToolTip>Tipo de modelo de lista</ToolTip><Default>ProductoListViewModel</Default>
        </Literal>
        <Literal>
          <ID>controller</ID><ToolTip>Controlador</ToolTip><Default>Productos</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[@model $ModelType$
@{
    ViewData["Title"] = "Listado";
    var sortOrder = ViewData["CurrentSort"] as string;
    var nameSort  = sortOrder == "name_asc" ? "name_desc" : "name_asc";
    var currentPage = Model.CurrentPage;
    var totalPages  = Model.TotalPages;
}

<div class="container-fluid py-4">

    <!-- Encabezado y acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">
                @Model.TotalItems elemento@(Model.TotalItems != 1 ? "s" : "") encontrado@(Model.TotalItems != 1 ? "s" : "")
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <!-- Exportar -->
            <a asp-controller="$controller$"
               asp-action="Export"
               asp-route-format="csv"
               class="btn btn-outline-secondary btn-sm"
               aria-label="Exportar listado a CSV">
                📥 Exportar CSV
            </a>
            <a asp-controller="$controller$"
               asp-action="Create"
               class="btn btn-primary btn-sm">
                ➕ Nuevo
            </a>
        </div>
    </div>

    <!-- Filtros y búsqueda -->
    <form asp-controller="$controller$" asp-action="Index" method="get" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="searchString" class="form-label visually-hidden">Buscar</label>
                    <input type="search"
                           id="searchString"
                           name="searchString"
                           class="form-control"
                           value="@ViewData["CurrentFilter"]"
                           placeholder="Buscar por nombre, categoría..."
                           aria-label="Buscar en el listado" />
                </div>
                <div class="col-md-3">
                    <label for="categoryFilter" class="form-label visually-hidden">Categoría</label>
                    <select id="categoryFilter" name="category" class="form-select" aria-label="Filtrar por categoría">
                        <option value="">Todas las categorías</option>
                        @foreach (var cat in ViewBag.Categories as IEnumerable<SelectListItem> ?? [])
                        {
                            <option value="@cat.Value" selected="@cat.Selected">@cat.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="hidden" name="sortOrder" value="@sortOrder" />
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                </div>
                <div class="col-md-2">
                    <a asp-controller="$controller$" asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </div>
        </div>
    </form>

    <!-- Tabla de datos -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0"
                   aria-label="Listado de @ViewData["Title"]"
                   aria-rowcount="@Model.TotalItems"
                   aria-colcount="5">
                <thead class="table-light">
                    <tr>
                        <!-- Encabezado ordenable -->
                        <th scope="col" aria-sort="@(sortOrder == "name_asc" ? "ascending" : sortOrder == "name_desc" ? "descending" : "none")">
                            <a asp-controller="$controller$"
                               asp-action="Index"
                               asp-route-sortOrder="@nameSort"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               class="text-decoration-none text-dark d-flex align-items-center gap-1">
                                Nombre
                                <span aria-hidden="true">@(sortOrder == "name_asc" ? "↑" : sortOrder == "name_desc" ? "↓" : "↕")</span>
                            </a>
                        </th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Precio</th>
                        <th scope="col">Estado</th>
                        <th scope="col"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5" role="cell">
                                No se encontraron elementos con los filtros actuales.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Nombre</strong>
                                    @if (!string.IsNullOrEmpty(item.Descripcion))
                                    {
                                        <small class="d-block text-muted">@item.Descripcion[..Math.Min(60, item.Descripcion.Length)]…</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">@item.Categoria</span>
                                </td>
                                <td>
                                    <span aria-label="Precio @item.Precio.ToString("C")">@item.Precio.ToString("C")</span>
                                </td>
                                <td>
                                    @if (item.EsActivo)
                                    {
                                        <span class="badge bg-success-subtle text-success" aria-label="Estado: Activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger" aria-label="Estado: Inactivo">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Acciones para @item.Nombre">
                                        <a asp-controller="$controller$"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-secondary"
                                           aria-label="Ver detalle de @item.Nombre">
                                            👁
                                        </a>
                                        <a asp-controller="$controller$"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary"
                                           aria-label="Editar @item.Nombre">
                                            ✏️
                                        </a>
                                        <button type="button"
                                                class="btn btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-item-id="@item.Id"
                                                data-item-name="@item.Nombre"
                                                aria-label="Eliminar @item.Nombre">
                                            🗑
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="2" class="text-muted small">
                            Página @currentPage de @totalPages
                        </td>
                        <td colspan="3" class="text-end">
                            <strong>Total: @Model.TotalItems elementos</strong>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Paginación -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-transparent">
                <nav aria-label="Paginación del listado">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="$controller$"
                               asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-sortOrder="@sortOrder"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               aria-label="Página anterior"
                               @(currentPage <= 1 ? "aria-disabled=true" : "")>
                                ‹ Anterior
                            </a>
                        </li>

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="$controller$"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-sortOrder="@sortOrder"
                                   asp-route-searchString="@ViewData["CurrentFilter"]"
                                   aria-label="Página @i"
                                   @(i == currentPage ? "aria-current=page" : "")>
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-controller="$controller$"
                               asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-sortOrder="@sortOrder"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               aria-label="Página siguiente">
                                Siguiente ›
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
