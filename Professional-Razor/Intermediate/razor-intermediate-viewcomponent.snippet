<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Razor Intermediate View Component</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>View Component ASP.NET Core 10 completo: clase C#, vista Razor y uso desde vista padre con parámetros</Description>
      <Shortcut>razor-intermediate-viewcomponent</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ComponentName</ID><ToolTip>Nombre del View Component (PascalCase)</ToolTip><Default>RecentProducts</Default>
        </Literal>
        <Literal>
          <ID>namespace</ID><ToolTip>Namespace de la aplicación</ToolTip><Default>MyApp.ViewComponents</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[// =============================================================
// View Component: $ComponentName$ViewComponent.cs
// Ubicar en: /ViewComponents/$ComponentName$ViewComponent.cs
// =============================================================
using Microsoft.AspNetCore.Mvc;

namespace $namespace$;

/// <summary>
/// View Component para mostrar elementos recientes.
/// Uso en vista: @await Component.InvokeAsync("$ComponentName$", new { count = 5 })
/// </summary>
public class $ComponentName$ViewComponent : ViewComponent
{
    private readonly IProductoRepository _repo;

    public $ComponentName$ViewComponent(IProductoRepository repo)
    {
        _repo = repo;
    }

    public async Task<IViewComponentResult> InvokeAsync(int count = 5, string? category = null)
    {
        var items = await _repo.GetRecentAsync(count, category);
        ViewData["Category"] = category ?? "Todos";
        return View(items);   // Renderiza Default.cshtml
    }
}

// =============================================================
// Vista: /Views/Shared/Components/$ComponentName$/Default.cshtml
// =============================================================
@*
@model IEnumerable<ProductoViewModel>
@{
    var category = ViewData["Category"] as string;
}

<section aria-labelledby="vc-$ComponentName$-heading" class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <h2 id="vc-$ComponentName$-heading" class="h6 mb-0">Productos Recientes - @category</h2>
        <a href="/productos" class="btn btn-sm btn-link">Ver todos</a>
    </div>
    <ul class="list-group list-group-flush" role="list">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-semibold">@item.Nombre</span>
                    <small class="d-block text-muted">@item.Categoria</small>
                </div>
                <span class="badge bg-primary rounded-pill" aria-label="Precio @item.Precio.ToString("C")">
                    @item.Precio.ToString("C")
                </span>
            </li>
        }
    </ul>
</section>
*@

// =============================================================
// Uso desde vista padre:
// =============================================================
@*
    <!-- Invocación asíncrona (recomendada) -->
    @await Component.InvokeAsync("$ComponentName$", new { count = 5 })

    <!-- Con Tag Helper (requiere addTagHelper) -->
    <vc:$ComponentName$ count="5" category="Electrónica"></vc:$ComponentName$>
*@
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
