<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Razor Intermediate Tag Helpers</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Tag Helpers ASP.NET Core 10 completos: form, input, select, validation, cache, environment y anchor</Description>
      <Shortcut>razor-intermediate-taghelpers</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ModelType</ID><ToolTip>Tipo del modelo</ToolTip><Default>ProductoViewModel</Default>
        </Literal>
        <Literal>
          <ID>controller</ID><ToolTip>Nombre del controlador</ToolTip><Default>Productos</Default>
        </Literal>
        <Literal>
          <ID>action</ID><ToolTip>Nombre de la acción</ToolTip><Default>Create</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[@model $ModelType$
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container py-4">

    <!-- Form Tag Helper con enrutamiento automático -->
    <form asp-controller="$controller$"
          asp-action="$action$"
          asp-antiforgery="true"
          method="post"
          enctype="multipart/form-data"
          class="needs-validation"
          novalidate>

        <!-- Input Tag Helper con binding automático -->
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre"
                   class="form-control"
                   asp-format="{0}"
                   placeholder="Nombre del producto" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <!-- Select con Items desde ViewBag -->
        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId"
                    asp-items="@(ViewBag.Categorias as SelectList)"
                    class="form-select">
                <option value="">-- Selecciona una categoría --</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
        </div>

        <!-- Textarea -->
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <!-- Input archivo -->
        <div class="mb-3">
            <label asp-for="Imagen" class="form-label"></label>
            <input asp-for="Imagen"
                   type="file"
                   class="form-control"
                   accept="image/webp,image/jpeg,image/png" />
            <span asp-validation-for="Imagen" class="text-danger small"></span>
        </div>

        <!-- Checkbox -->
        <div class="form-check mb-4">
            <input asp-for="EsActivo" class="form-check-input" />
            <label asp-for="EsActivo" class="form-check-label"></label>
        </div>

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-controller="$controller$" asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </form>

    <!-- Cache Tag Helper: contenido cacheado por 10 minutos -->
    <cache expires-after="@TimeSpan.FromMinutes(10)" vary-by-user="false">
        <p class="text-muted small mt-4">
            Categorías disponibles: @(ViewBag.TotalCategorias ?? 0)
            <small>(actualizado: @DateTime.Now.ToString("HH:mm"))</small>
        </p>
    </cache>

    <!-- Environment Tag Helper: muestra según entorno -->
    <environment include="Development">
        <div class="alert alert-info mt-3" role="status">
            Modo desarrollo: validación del lado del servidor activa.
        </div>
    </environment>
    <environment exclude="Development">
        <!-- Producción: scripts minificados -->
    </environment>

    <!-- Anchor Tag Helper con área y parámetros de ruta -->
    <div class="mt-3">
        <a asp-area="Admin"
           asp-controller="$controller$"
           asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="20"
           class="btn btn-link btn-sm">
            Ver listado completo
        </a>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    $end$
}]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
