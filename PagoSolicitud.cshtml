@{
    ViewData["Title"] = "Pagos";

    // ------------------------------------------------------------------
    // Datos de vista (hardcoded). Nombrados pensando en un futuro
    // PagosViewModel: NombrePago (dinámico por sistema/cliente, igual que
    // Header.Branding.SystemName), Pagos[] (Folio, Poliza, Titular,
    // Motivo, Monto, FechaDescarga, Complemento?).
    // ------------------------------------------------------------------
    var nombrePago = "Pago Grupo Modelo";

    var iconoPorMotivo = new Dictionary<string, string>
    {
        ["Consultas"] = "stethoscope",
        ["Medicamentos"] = "pill",
        ["Vacunas"] = "syringe",
        ["Laboratorio y Gabinete"] = "flask-conical",
        ["Cuidados Preventivos"] = "heart-pulse",
        ["Exámenes de Audición"] = "ear",
        ["Lentes"] = "glasses",
        ["Gastos en el Extranjero"] = "plane",
    };

    var pagos = new[]
    {
        new { Folio = "0000926100", Poliza = "38603787", Titular = "Carlos Moncayo Espinosa",       Motivo = "Medicamentos",           Monto = 1604.00m,  Fecha = "10/04/2026", Complemento = "COMP-004471" },
        new { Folio = "0001126100", Poliza = "38603787", Titular = "Carlos Moncayo Espinosa",       Motivo = "Medicamentos",           Monto = 9913.62m,  Fecha = "10/04/2026", Complemento = "COMP-004472" },
        new { Folio = "0001226100", Poliza = "32183470", Titular = "Jáder Medina",                  Motivo = "Laboratorio y Gabinete",  Monto = 4414.00m,  Fecha = "10/04/2026", Complemento = "COMP-004480" },
        new { Folio = "0101326141", Poliza = "38602287", Titular = "Ésner Valencia Valencia",        Motivo = "Consultas",               Monto = 2000.00m,  Fecha = "09/07/2026", Complemento = (string?)null },
        new { Folio = "0106626184", Poliza = "38603787", Titular = "Carlos Moncayo Espinosa",       Motivo = "Gastos en el Extranjero", Monto = 4470.92m,  Fecha = "09/07/2026", Complemento = "COMP-005102" },
        new { Folio = "0106826184", Poliza = "32141088", Titular = "Alfredo Miguel Riera Losada",   Motivo = "Gastos en el Extranjero", Monto = 26203.95m, Fecha = "09/07/2026", Complemento = (string?)null },
        new { Folio = "0106926184", Poliza = "32141088", Titular = "Alfredo Miguel Riera Losada",   Motivo = "Gastos en el Extranjero", Monto = 17190.70m, Fecha = "09/07/2026", Complemento = (string?)null },
        new { Folio = "0107026184", Poliza = "32141088", Titular = "Alfredo Miguel Riera Losada",   Motivo = "Lentes",                 Monto = 1500.00m,  Fecha = "09/07/2026", Complemento = "COMP-005110" },
        new { Folio = "0107226184", Poliza = "38603787", Titular = "Carlos Moncayo Espinosa",       Motivo = "Gastos en el Extranjero", Monto = 1773.68m,  Fecha = "09/07/2026", Complemento = "COMP-005118" },
        new { Folio = "0107526189", Poliza = "38603787", Titular = "Carlos Moncayo Espinosa",       Motivo = "Consultas",               Monto = 2500.00m,  Fecha = "09/07/2026", Complemento = "COMP-005125" },
    };

    var montoTotal = pagos.Sum(p => p.Monto);
    var pendientes = pagos.Count(p => p.Complemento == null);
    var culturaMx = new System.Globalization.CultureInfo("es-MX");
}

<div class="pagos-view">

    <div class="page-head">
        <h1 class="page-display">@nombrePago</h1>
        <p class="page-lead">Consulta y descarga los pagos autorizados y sus complementos de reembolso.</p>
    </div>

    @* ---------------------------------------------------------------------
       Intercambio de archivos (Layout Pagos / Retro)
       --------------------------------------------------------------------- *@
    <section aria-label="Intercambio de archivos de pago" class="file-actions">
        <a href="#" class="file-action-btn" download>
            <span class="file-action-icon"><i data-lucide="cloud-download" aria-hidden="true"></i></span>
            <span class="file-action-text">
                <span class="file-action-title">Layout Pagos</span>
                <span class="file-action-desc">Descarga la plantilla del lote de pagos vigente</span>
            </span>
        </a>
        <button type="button" class="file-action-btn" data-bs-toggle="modal" data-bs-target="#modalRetro">
            <span class="file-action-icon"><i data-lucide="cloud-upload" aria-hidden="true"></i></span>
            <span class="file-action-text">
                <span class="file-action-title">Retro Grupo Modelo</span>
                <span class="file-action-desc">Carga el archivo de retorno bancario para conciliar pagos</span>
            </span>
        </button>
    </section>

    @* ---------------------------------------------------------------------
       Panel de Filtros
       --------------------------------------------------------------------- *@
    <section class="filters-panel" aria-label="Filtros de pagos">
        <div class="filters-panel-head">
            <h2 class="filters-panel-title">
                <i data-lucide="filter" aria-hidden="true"></i>
                Filtros
            </h2>            
        </div>

        <form class="filters-form" role="search">
            <div class="filters-row">
                <partial name="Partials/_DatePicker" model='new DatePickerViewModel {
                    Id = "fFechaDesde",
                    Name = "fFechaDesde",
                    Label = "Fecha desde"
                }' />
                <partial name="Partials/_DatePicker" model='new DatePickerViewModel {
                    Id = "fFechaHasta",
                    Name = "fFechaHasta",
                    Label = "Fecha hasta"
                }' />
                <div class="field">
                    <label for="fFolio" class="field-label">Folio</label>
                    <input type="text" id="fFolio" class="form-control" placeholder="0107526189">
                </div>
            </div>
            <div class="filters-actions">
                <button type="submit" class="btn-primary-vm">
                    <i data-lucide="search" aria-hidden="true"></i> Buscar
                </button>
                <button type="reset" class="btn-text-vm">Limpiar filtros</button>
            </div>
        </form>
    </section>



    @* ---------------------------------------------------------------------
       Tabla de pagos
       --------------------------------------------------------------------- *@
    <section class="table-panel" aria-label="Detalle de pagos">
        <div class="table-panel-head">
            <span class="table-count">@pagos.Length resultados</span>
        </div>

        <div class="table-scroll">
            <table class="vm-table">
                <thead>
                    <tr>
                        <th scope="col">Folio</th>
                        <th scope="col">Nombre titular</th>
                        <th scope="col" class="ta-right">Monto autorizado</th>
                        <th scope="col" class="ta-center">Fecha de descarga</th>
                        <th scope="col">N.º de complemento</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pagos)
                    {
                        var icono = iconoPorMotivo.TryGetValue(p.Motivo, out var ic) ? ic : "circle";

                        <tr>
                            <td>
                                <span class="folio-text">@p.Folio</span>
                                <span class="folio-sub">Póliza @p.Poliza</span>
                            </td>
                            <td>@p.Titular</td>
                            <td class="ta-right monto-cell">@p.Monto.ToString("C2", culturaMx)</td>
                            <td class="ta-center">@p.Fecha</td>
                            <td>
                                @if (p.Complemento is not null)
                                {
                                    <span class="badge-status badge-status--warning">@p.Complemento</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status--success">@p.Folio</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-panel-foot">
            <span class="table-range">Mostrando 1–@pagos.Length de @pagos.Length</span>
            <nav aria-label="Paginación de pagos">
                <ul class="pagination pagination-vm">
                    <li class="page-item disabled"><a class="page-link" href="#" aria-label="Anterior"><i data-lucide="chevron-left" aria-hidden="true"></i></a></li>
                    <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                    <li class="page-item disabled"><a class="page-link" href="#" aria-label="Siguiente"><i data-lucide="chevron-right" aria-hidden="true"></i></a></li>
                </ul>
            </nav>
        </div>
    </section>
</div>

@* =====================================================================
   Modal · Cargar archivo Retro
   ===================================================================== *@
<div class="modal fade" id="modalRetro" tabindex="-1" aria-labelledby="modalRetroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="modalRetroLabel">Cargar Retro Grupo Modelo</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p style="margin:0 0 var(--vm-space-4);color:var(--vm-neutral-700);font-size:var(--vm-text-small)">
                    Selecciona el archivo de retorno bancario para conciliar los pagos de este periodo.
                </p>
                <div class="field">
                    <label class="field-label" for="inputRetroArchivo">Archivo de retorno</label>
                    <input type="file" id="inputRetroArchivo" class="form-control" accept=".txt,.csv,.xlsx">
                    <span id="retroArchivoNombre" style="font-size:var(--vm-text-micro);color:var(--vm-neutral-500)">Ningún archivo seleccionado</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-text-vm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn-primary-vm" id="btnConfirmarRetro">
                    <i data-lucide="upload" aria-hidden="true"></i> Cargar archivo
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pagos-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pagos-index.js" asp-append-version="true"></script>
}
