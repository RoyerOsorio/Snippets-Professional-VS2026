<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Bootstrap 5 Advanced Responsive Grid</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Grid system Bootstrap 5.3.3 avanzado con CSS Grid nativo, masonry, auto-fill y columnas responsivas complejas</Description>
      <Shortcut>bs-advanced-responsive-grid</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>minColWidth</ID><ToolTip>Ancho mínimo de columna en el grid auto-fill</ToolTip><Default>280px</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- === GRID AVANZADO BOOTSTRAP 5.3.3 === -->

<!-- 1. Grid auto-fill con CSS Grid nativo (sin clases BS para máxima flexibilidad) -->
<section class="mb-5" aria-labelledby="grid-auto-heading">
  <h2 id="grid-auto-heading" class="mb-3">Grid Auto-Fill</h2>
  <div style="
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax($minColWidth$, 1fr));
    gap: 1.5rem;
  ">
    <div class="card h-100">Elemento 1</div>
    <div class="card h-100">Elemento 2</div>
    <div class="card h-100">Elemento 3</div>
    <div class="card h-100">Elemento 4</div>
    $end$
  </div>
</section>

<!-- 2. Layout asimétrico (2/3 + 1/3) con columna featured -->
<section class="mb-5" aria-labelledby="grid-asym-heading">
  <h2 id="grid-asym-heading" class="mb-3">Layout Asimétrico</h2>
  <div class="row g-4">
    <!-- Elemento destacado (ocupa 2 columnas en md+) -->
    <div class="col-12 col-md-8">
      <div class="card h-100 border-primary">
        <div class="card-body">
          <span class="badge bg-primary mb-2">Destacado</span>
          <h3 class="card-title">Artículo Principal</h3>
          <p class="card-text text-muted">Contenido del elemento destacado con mayor visibilidad.</p>
        </div>
      </div>
    </div>
    <!-- Columna lateral (1/3) -->
    <div class="col-12 col-md-4 d-flex flex-column gap-4">
      <div class="card flex-grow-1">
        <div class="card-body"><h4 class="card-title h6">Elemento Secundario 1</h4></div>
      </div>
      <div class="card flex-grow-1">
        <div class="card-body"><h4 class="card-title h6">Elemento Secundario 2</h4></div>
      </div>
    </div>
  </div>
</section>

<!-- 3. Grid de tarjetas con row-cols y gutter responsive -->
<section class="mb-5" aria-labelledby="grid-cards-heading">
  <h2 id="grid-cards-heading" class="mb-3">Grid de Tarjetas</h2>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 g-lg-4">
    <div class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title h6">Tarjeta 1</h3>
          <p class="card-text small text-muted">Descripción breve.</p>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title h6">Tarjeta 2</h3>
          <p class="card-text small text-muted">Descripción breve.</p>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title h6">Tarjeta 3</h3>
          <p class="card-text small text-muted">Descripción breve.</p>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title h6">Tarjeta 4</h3>
          <p class="card-text small text-muted">Descripción breve.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4. Grid con span de celdas (elemento hero wide) -->
<section aria-labelledby="grid-span-heading">
  <h2 id="grid-span-heading" class="mb-3">Grid con Spans</h2>
  <div style="
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto;
    gap: 1rem;
  ">
    <!-- Hero: ocupa 2 columnas y 2 filas -->
    <div class="card" style="grid-column: 1 / span 2; grid-row: 1 / span 2;">
      <div class="card-body"><h3>Hero Item</h3><p>Grande y prominente.</p></div>
    </div>
    <div class="card"><div class="card-body"><h4 class="h6">Item B</h4></div></div>
    <div class="card"><div class="card-body"><h4 class="h6">Item C</h4></div></div>
    <div class="card" style="grid-column: 1 / span 3;">
      <div class="card-body"><h4 class="h6">Item Full Width</h4></div>
    </div>
  </div>
</section>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
