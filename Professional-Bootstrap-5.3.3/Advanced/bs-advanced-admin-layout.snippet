<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Bootstrap 5 Advanced Admin Layout</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Layout de administración Bootstrap 5.3.3 con offcanvas mobile, dark mode toggle, toasts y perfil de usuario</Description>
      <Shortcut>bs-advanced-admin-layout</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>appName</ID><ToolTip>Nombre de la aplicación admin</ToolTip><Default>Admin Pro</Default>
        </Literal>
        <Literal>
          <ID>pageTitle</ID><ToolTip>Título de la sección actual</ToolTip><Default>Gestión de Usuarios</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Bootstrap Admin Layout con Offcanvas Mobile y Dark Mode -->
<div class="d-flex min-vh-100">

  <!-- Sidebar Offcanvas (móvil) / fijo (desktop) -->
  <div class="offcanvas-lg offcanvas-start bg-dark text-white"
       tabindex="-1"
       id="adminSidebar"
       aria-labelledby="adminSidebarLabel"
       style="width:250px;">
    <div class="offcanvas-header border-bottom border-secondary">
      <h5 class="offcanvas-title text-white" id="adminSidebarLabel">$appName$</h5>
      <button type="button"
              class="btn-close btn-close-white"
              data-bs-dismiss="offcanvas"
              data-bs-target="#adminSidebar"
              aria-label="Cerrar menú"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
      <nav aria-label="Navegación del panel de administración">
        <ul class="nav nav-pills flex-column p-3 gap-1">
          <li><a href="#" class="nav-link text-white active" aria-current="page"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
          <li><a href="#" class="nav-link text-white-50"><i class="bi bi-people me-2"></i>Usuarios</a></li>
          <li><a href="#" class="nav-link text-white-50"><i class="bi bi-box me-2"></i>Productos</a></li>
          <li><a href="#" class="nav-link text-white-50"><i class="bi bi-receipt me-2"></i>Pedidos</a></li>
          <li><a href="#" class="nav-link text-white-50"><i class="bi bi-bar-chart me-2"></i>Reportes</a></li>
          <li><hr class="border-secondary" /></li>
          <li><a href="#" class="nav-link text-white-50"><i class="bi bi-gear me-2"></i>Configuración</a></li>
        </ul>
      </nav>
      <div class="mt-auto p-3 border-top border-secondary">
        <a href="/logout" class="nav-link text-white-50"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a>
      </div>
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="flex-grow-1 d-flex flex-column overflow-hidden">

    <!-- Topbar -->
    <header class="navbar bg-body border-bottom px-3 sticky-top" style="z-index:1020;">
      <!-- Botón abrir sidebar en móvil -->
      <button class="btn btn-outline-secondary d-lg-none me-2"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#adminSidebar"
              aria-controls="adminSidebar"
              aria-label="Abrir menú">
        <i class="bi bi-list" aria-hidden="true"></i>
      </button>

      <span class="navbar-brand d-none d-lg-block fw-bold">$appName$</span>

      <div class="ms-auto d-flex align-items-center gap-2">
        <!-- Dark mode toggle (WCAG 1.4.3) -->
        <div class="form-check form-switch mb-0 d-flex align-items-center">
          <input class="form-check-input" type="checkbox" role="switch" id="darkModeToggle"
                 aria-label="Alternar modo oscuro" />
          <label class="form-check-label ms-2 visually-hidden" for="darkModeToggle">Modo oscuro</label>
          <i class="bi bi-moon-stars ms-1" aria-hidden="true"></i>
        </div>

        <!-- Perfil de usuario -->
        <div class="dropdown">
          <button class="btn btn-sm d-flex align-items-center gap-2"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-label="Menú de usuario">
            <img src="/img/avatar.webp" alt="Avatar de Juan Pérez" width="32" height="32" class="rounded-circle" />
            <span class="d-none d-md-inline">Juan Pérez</span>
            <i class="bi bi-chevron-down small" aria-hidden="true"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li><h6 class="dropdown-header">juan@empresa.com</h6></li>
            <li><a class="dropdown-item" href="/perfil"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
            <li><a class="dropdown-item" href="/configuracion"><i class="bi bi-gear me-2"></i>Configuración</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
          </ul>
        </div>
      </div>
    </header>

    <!-- Área de contenido -->
    <main class="flex-grow-1 p-3 p-lg-4 overflow-auto" id="main-content" tabindex="-1">

      <!-- Page header -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h1 class="h3 mb-1">$pageTitle$</h1>
          <nav aria-label="Ruta de navegación">
            <ol class="breadcrumb mb-0 small">
              <li class="breadcrumb-item"><a href="/dashboard">Inicio</a></li>
              <li class="breadcrumb-item active" aria-current="page">$pageTitle$</li>
            </ol>
          </nav>
        </div>
        <button class="btn btn-primary" type="button">
          <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Nuevo elemento
        </button>
      </div>

      <!-- Contenido de la página -->
      $end$
    </main>

  </div>
</div>

<!-- Toast container para notificaciones -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite" aria-atomic="true">
  <div id="liveToast" class="toast" role="status">
    <div class="toast-header">
      <strong class="me-auto">Notificación</strong>
      <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Cerrar notificación"></button>
    </div>
    <div class="toast-body" id="toast-message">Operación completada con éxito.</div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Dark mode toggle
  const toggle = document.getElementById('darkModeToggle');
  const html   = document.documentElement;
  const stored = localStorage.getItem('theme') ?? 'auto';
  html.setAttribute('data-bs-theme', stored);
  if (stored === 'dark') toggle.checked = true;

  toggle?.addEventListener('change', () => {
    const theme = toggle.checked ? 'dark' : 'light';
    html.setAttribute('data-bs-theme', theme);
    localStorage.setItem('theme', theme);
  });

  // Helper para mostrar toast
  function showToast(message, type = 'success') {
    const toastEl = document.getElementById('liveToast');
    document.getElementById('toast-message').textContent = message;
    toastEl?.classList.toggle('text-bg-success', type === 'success');
    toastEl?.classList.toggle('text-bg-danger', type === 'error');
    bootstrap.Toast.getOrCreateInstance(toastEl).show();
  }
</script>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
