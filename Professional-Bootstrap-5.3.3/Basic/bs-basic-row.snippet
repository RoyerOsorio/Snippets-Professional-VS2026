<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Bootstrap 5 Basic Row</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Fila Bootstrap 5.3.3 con gutters, alineación, columnas automáticas y clases row-cols</Description>
      <Shortcut>bs-basic-row</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>rowCols</ID>
          <ToolTip>Columnas automáticas: row-cols-1, row-cols-2, row-cols-md-3, etc.</ToolTip>
          <Default>row-cols-1 row-cols-md-2 row-cols-lg-3</Default>
        </Literal>
        <Literal>
          <ID>gutter</ID>
          <ToolTip>Espaciado entre columnas: g-0, g-2, g-3, g-4, gx-3, gy-4</ToolTip>
          <Default>g-4</Default>
        </Literal>
        <Literal>
          <ID>align</ID>
          <ToolTip>Alineación vertical: align-items-start, align-items-center, align-items-end</ToolTip>
          <Default>align-items-stretch</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Fila Bootstrap 5.3.3 con grid responsivo -->
<div class="row $rowCols$ $gutter$ $align$">
  <!-- Columna individual -->
  <div class="col">
    $end$
  </div>
</div>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
