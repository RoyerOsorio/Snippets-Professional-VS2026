<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Bootstrap 5 Basic Button</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Botones Bootstrap 5.3.3 con variantes semánticas, tamaños, estados y accesibilidad ARIA</Description>
      <Shortcut>bs-basic-button</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>variant</ID>
          <ToolTip>Variante: primary, secondary, success, danger, warning, info, light, dark, outline-primary</ToolTip>
          <Default>primary</Default>
        </Literal>
        <Literal>
          <ID>size</ID>
          <ToolTip>Tamaño: btn-sm, btn-lg, o vacío para normal</ToolTip>
          <Default></Default>
        </Literal>
        <Literal>
          <ID>label</ID>
          <ToolTip>Texto visible del botón</ToolTip>
          <Default>Acción Principal</Default>
        </Literal>
        <Literal>
          <ID>ariaLabel</ID>
          <ToolTip>Descripción accesible ampliada (si el texto del botón no es suficientemente descriptivo)</ToolTip>
          <Default>Ejecutar acción principal</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Botón Bootstrap 5.3.3 accesible -->
<button type="button"
        class="btn btn-$variant$ $size$"
        aria-label="$ariaLabel$">
  $label$
</button>

<!-- Variantes de referencia rápida:
  Sólidos   : btn-primary | btn-secondary | btn-success | btn-danger | btn-warning
  Outline   : btn-outline-primary | btn-outline-secondary | btn-outline-danger
  Tamaños   : btn-sm | btn-lg
  Estados   : disabled | aria-disabled="true"
  Con icono : <span aria-hidden="true" class="bi bi-check"></span> Guardar
-->
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
