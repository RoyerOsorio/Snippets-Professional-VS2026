<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Bootstrap 5 Intermediate Modal</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Modal Bootstrap 5.3.3 accesible con focus trap, ARIA dialog, confirmación destructiva y botón disparador</Description>
      <Shortcut>bs-intermediate-modal</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>modalId</ID><ToolTip>ID único del modal</ToolTip><Default>confirmModal</Default>
        </Literal>
        <Literal>
          <ID>modalTitle</ID><ToolTip>Título del modal</ToolTip><Default>Confirmar Acción</Default>
        </Literal>
        <Literal>
          <ID>modalBody</ID><ToolTip>Mensaje del cuerpo del modal</ToolTip><Default>¿Está seguro de que desea continuar con esta acción? Esta operación no se puede deshacer.</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Botón disparador del modal -->
<button type="button"
        class="btn btn-danger"
        data-bs-toggle="modal"
        data-bs-target="#$modalId$"
        aria-haspopup="dialog">
  Abrir Modal
</button>

<!-- Modal Bootstrap 5.3.3 accesible (WCAG 2.1 - ARIA Dialog) -->
<div class="modal fade"
     id="$modalId$"
     tabindex="-1"
     role="dialog"
     aria-labelledby="$modalId$-title"
     aria-describedby="$modalId$-body"
     aria-modal="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content shadow">

      <!-- Header -->
      <div class="modal-header border-0 pb-0">
        <h2 class="modal-title h5 fw-semibold" id="$modalId$-title">
          <span aria-hidden="true" class="me-2">⚠️</span>
          $modalTitle$
        </h2>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Cerrar modal $modalTitle$">
        </button>
      </div>

      <!-- Body -->
      <div class="modal-body" id="$modalId$-body">
        <p>$modalBody$</p>

        <!-- Zona para contenido dinámico -->
        <div id="$modalId$-dynamic-content">
          $end$
        </div>
      </div>

      <!-- Footer con acciones -->
      <div class="modal-footer border-0 pt-0 gap-2">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
          Cancelar
        </button>
        <button type="button"
                class="btn btn-danger"
                id="$modalId$-confirm-btn"
                aria-describedby="$modalId$-title">
          Confirmar
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  // Gestión del modal con Bootstrap JS API
  const modalEl = document.getElementById('$modalId$');
  if (modalEl) {
    const modal = new bootstrap.Modal(modalEl);

    // Foco al botón de confirmación al abrir (accesibilidad)
    modalEl.addEventListener('shown.bs.modal', () => {
      document.getElementById('$modalId$-confirm-btn')?.focus();
    });

    // Acción al confirmar
    document.getElementById('$modalId$-confirm-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('$modalId$-confirm-btn');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Procesando...';
      btn.setAttribute('aria-busy', 'true');

      try {
        // TODO: ejecutar acción asíncrona
        await new Promise(r => setTimeout(r, 1000)); // simulación
        modal.hide();
      } finally {
        btn.disabled = false;
        btn.textContent = 'Confirmar';
        btn.removeAttribute('aria-busy');
      }
    });
  }
</script>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
