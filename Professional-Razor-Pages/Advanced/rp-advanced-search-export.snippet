<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Razor Pages Advanced — Búsqueda y Exportación</Title>
      <Author>VS2026 Snippets Library</Author>
      <Description>PageModel avanzado con búsqueda server-side, ordenación, paginación, exportación CSV, autorización y manejo de errores.</Description>
      <Shortcut>rp-advanced-search-export</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>PageName</ID>
          <ToolTip>Nombre de la página (ej: Products)</ToolTip>
          <Default>Products</Default>
        </Literal>
        <Literal>
          <ID>EntityName</ID>
          <ToolTip>Nombre de la entidad (ej: Product)</ToolTip>
          <Default>Product</Default>
        </Literal>
        <Literal>
          <ID>ServiceName</ID>
          <ToolTip>Nombre del servicio (ej: IProductService)</ToolTip>
          <Default>IProductService</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp">
        <![CDATA[// ============================================================
// $PageName$Model.cshtml.cs — Razor Page avanzada
// ============================================================
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using System.Text;

[Authorize]
public class $PageName$Model : PageModel
{
    private readonly $ServiceName$ _service;
    private readonly ILogger<$PageName$Model> _logger;

    public $PageName$Model($ServiceName$ service, ILogger<$PageName$Model> logger)
    {
        _service = service;
        _logger = logger;
    }

    // ---- Estado de la página ----
    public IReadOnlyList<$EntityName$ViewModel> Items { get; private set; } = [];
    public PaginationInfo Pagination { get; private set; } = new();
    public string? ErrorMessage { get; private set; }

    // ---- Parámetros enlazados ----
    [BindProperty(SupportsGet = true)]
    public SearchQuery Query { get; set; } = new();

    // ---- GET: carga paginada con filtros ----
    public async Task<IActionResult> OnGetAsync(CancellationToken ct)
    {
        try
        {
            var result = await _service.SearchAsync(Query, ct);
            Items = result.Items
                         .Select($EntityName$ViewModel.From)
                         .ToList()
                         .AsReadOnly();
            Pagination = result.Pagination;
            return Page();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error al cargar $PageName$");
            ErrorMessage = "Ocurrió un error al cargar los datos.";
            return Page();
        }
    }

    // ---- POST: eliminar registro ----
    public async Task<IActionResult> OnPostDeleteAsync(int id, CancellationToken ct)
    {
        if (!ModelState.IsValid) return BadRequest(ModelState);

        try
        {
            await _service.DeleteAsync(id, ct);
            TempData["SuccessMessage"] = "Registro eliminado correctamente.";
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error al eliminar {Id}", id);
            TempData["ErrorMessage"] = "No se pudo eliminar el registro.";
        }

        return RedirectToPage();
    }

    // ---- GET: exportar CSV ----
    public async Task<IActionResult> OnGetExportCsvAsync(CancellationToken ct)
    {
        var all = await _service.GetAllForExportAsync(Query, ct);

        var csv = new StringBuilder();
        csv.AppendLine("Id,Nombre,Descripción,Activo,Fecha Creación");

        foreach (var item in all)
        {
            csv.AppendLine(
                $"{item.Id},{EscapeCsv(item.Name)},{EscapeCsv(item.Description)},{item.IsActive},{item.CreatedAt:yyyy-MM-dd}"
            );
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        return File(bytes, "text/csv", $"$PageName$-{DateTime.UtcNow:yyyyMMdd}.csv");
    }

    private static string EscapeCsv(string? value) =>
        value is null ? string.Empty : $"\"{value.Replace("\"", "\"\"")}\"";
}

// ============================================================
// Modelos y DTOs
// ============================================================

public record SearchQuery
{
    public string? Search { get; init; }
    public bool? IsActive { get; init; }
    public string SortBy { get; init; } = "name";
    public string SortDirection { get; init; } = "asc";
    public int Page { get; init; } = 1;
    public int PageSize { get; init; } = 20;
}

public record $EntityName$ViewModel
{
    public int Id { get; init; }
    public string Name { get; init; } = string.Empty;
    public string Description { get; init; } = string.Empty;
    public bool IsActive { get; init; }
    public string CreatedAt { get; init; } = string.Empty;

    public static $EntityName$ViewModel From($EntityName$ entity) => new()
    {
        Id = entity.Id,
        Name = entity.Name,
        Description = entity.Description,
        IsActive = entity.IsActive,
        CreatedAt = entity.CreatedAt.ToString("dd/MM/yyyy"),
    };
}

public record PaginationInfo
{
    public int CurrentPage { get; init; } = 1;
    public int TotalPages { get; init; } = 1;
    public int TotalItems { get; init; } = 0;
    public int PageSize { get; init; } = 20;
    public bool HasPrevious => CurrentPage > 1;
    public bool HasNext => CurrentPage < TotalPages;
}

// ============================================================
// Interfaz del servicio (implementar en la capa de aplicación)
// ============================================================

public interface $ServiceName$
{
    Task<PagedResult<$EntityName$>> SearchAsync(SearchQuery query, CancellationToken ct);
    Task<IEnumerable<$EntityName$>> GetAllForExportAsync(SearchQuery query, CancellationToken ct);
    Task DeleteAsync(int id, CancellationToken ct);
}

public record PagedResult<T>
{
    public IReadOnlyList<T> Items { get; init; } = [];
    public PaginationInfo Pagination { get; init; } = new();
}

// ---- Entidad de dominio (placeholder) ----
public class $EntityName$
{
    public int Id { get; set; }
    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public bool IsActive { get; set; }
    public DateTime CreatedAt { get; set; }
}
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
