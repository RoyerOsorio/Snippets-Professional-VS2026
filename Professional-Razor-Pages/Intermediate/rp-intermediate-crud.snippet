<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Razor Pages Intermediate CRUD</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Página Razor Pages con operaciones CRUD completas: handlers OnGet/OnPost/OnPostDelete con validación</Description>
      <Shortcut>rp-intermediate-crud</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>EntityName</ID><ToolTip>Nombre de la entidad</ToolTip><Default>Producto</Default>
        </Literal>
        <Literal>
          <ID>namespace</ID><ToolTip>Namespace</ToolTip><Default>MyApp.Pages.Productos</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using System.ComponentModel.DataAnnotations;

namespace $namespace$;

public class IndexModel : PageModel
{
    private readonly I$EntityName$Service _service;

    [BindProperty]
    public $EntityName$InputModel Input { get; set; } = new();

    [BindProperty(SupportsGet = true)]
    public string? SearchString { get; set; }

    [BindProperty(SupportsGet = true)]
    public int CurrentPage { get; set; } = 1;

    public PagedResult<$EntityName$Dto> Items { get; set; } = PagedResult<$EntityName$Dto>.Empty;

    public IndexModel(I$EntityName$Service service) => _service = service;

    // GET: /Productos - Listar con búsqueda y paginación
    public async Task OnGetAsync(CancellationToken ct)
    {
        Items = await _service.GetPagedAsync(SearchString, CurrentPage, 20, ct);
    }

    // GET: /Productos?handler=Edit&id=5 - Cargar elemento para edición
    public async Task<IActionResult> OnGetEditAsync(int id, CancellationToken ct)
    {
        var item = await _service.GetByIdAsync(id, ct);
        if (item is null) return NotFound();

        Input = new $EntityName$InputModel
        {
            Id          = item.Id,
            Nombre      = item.Nombre,
            Descripcion = item.Descripcion,
            Precio      = item.Precio
        };
        Items = await _service.GetPagedAsync(null, 1, 20, ct);
        return Page();
    }

    // POST: /Productos - Crear o actualizar
    public async Task<IActionResult> OnPostAsync(CancellationToken ct)
    {
        if (!ModelState.IsValid)
        {
            Items = await _service.GetPagedAsync(SearchString, CurrentPage, 20, ct);
            return Page();
        }

        if (Input.Id == 0)
            await _service.CreateAsync(Input, ct);
        else
            await _service.UpdateAsync(Input.Id, Input, ct);

        TempData["Success"] = Input.Id == 0 ? "Elemento creado." : "Elemento actualizado.";
        return RedirectToPage();
    }

    // POST: /Productos?handler=Delete - Eliminar
    public async Task<IActionResult> OnPostDeleteAsync(int id, CancellationToken ct)
    {
        var result = await _service.DeleteAsync(id, ct);
        TempData[result.IsSuccess ? "Success" : "Error"] =
            result.IsSuccess ? "Elemento eliminado correctamente." : result.Error;
        return RedirectToPage();
    }
    $end$
}

// Input Model con validaciones
public class $EntityName$InputModel
{
    public int Id { get; set; }

    [Required(ErrorMessage = "El nombre es obligatorio.")]
    [StringLength(200, MinimumLength = 2)]
    [Display(Name = "Nombre")]
    public string Nombre { get; set; } = string.Empty;

    [StringLength(1000)]
    [Display(Name = "Descripción")]
    public string Descripcion { get; set; } = string.Empty;

    [Required(ErrorMessage = "El precio es obligatorio.")]
    [Range(0, double.MaxValue, ErrorMessage = "El precio debe ser mayor o igual a cero.")]
    [Display(Name = "Precio")]
    [DataType(DataType.Currency)]
    public decimal Precio { get; set; }
}]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
