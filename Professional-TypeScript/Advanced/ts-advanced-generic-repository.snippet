<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>TS Generic Repository Pattern</Title>
      <Author>VS2026 Snippets Library</Author>
      <Description>Implementación avanzada del patrón Repository genérico con Unit of Work, especificaciones, Result monad y tipos estrictos.</Description>
      <Shortcut>ts-advanced-generic-repository</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>EntityName</ID>
          <ToolTip>Nombre de la entidad de dominio (ej: Product)</ToolTip>
          <Default>Product</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript">
        <![CDATA[// ============================================================
// Result Monad — manejo funcional de errores sin excepciones
// ============================================================

export type Result<T, E = Error> =
  | { ok: true; value: T }
  | { ok: false; error: E };

export const Result = {
  ok<T>(value: T): Result<T> { return { ok: true, value }; },
  fail<E = Error>(error: E): Result<never, E> { return { ok: false, error }; },
};

// ============================================================
// Tipos base de entidad
// ============================================================

export interface Entity {
  id: number;
  createdAt: Date;
  updatedAt: Date;
}

export type CreateDto<T extends Entity> = Omit<T, 'id' | 'createdAt' | 'updatedAt'>;
export type UpdateDto<T extends Entity> = Partial<CreateDto<T>>;

// ============================================================
// Patrón Specification — criterios de consulta componibles
// ============================================================

export interface Specification<T> {
  isSatisfiedBy(entity: T): boolean;
  toQueryParams(): Record<string, unknown>;
}

export class AndSpecification<T> implements Specification<T> {
  constructor(
    private readonly left: Specification<T>,
    private readonly right: Specification<T>
  ) {}

  isSatisfiedBy(entity: T): boolean {
    return this.left.isSatisfiedBy(entity) && this.right.isSatisfiedBy(entity);
  }

  toQueryParams(): Record<string, unknown> {
    return { ...this.left.toQueryParams(), ...this.right.toQueryParams() };
  }
}

// ============================================================
// Interfaz del repositorio genérico
// ============================================================

export interface IRepository<T extends Entity> {
  findById(id: number): Promise<Result<T | null>>;
  findAll(spec?: Specification<T>): Promise<Result<T[]>>;
  findPaged(
    page: number,
    pageSize: number,
    spec?: Specification<T>
  ): Promise<Result<{ items: T[]; total: number }>>;
  create(dto: CreateDto<T>): Promise<Result<T>>;
  update(id: number, dto: UpdateDto<T>): Promise<Result<T>>;
  delete(id: number): Promise<Result<void>>;
  exists(id: number): Promise<boolean>;
  count(spec?: Specification<T>): Promise<number>;
}

// ============================================================
// Entidad de dominio
// ============================================================

export interface $EntityName$ extends Entity {
  name: string;
  description: string;
  isActive: boolean;
}

// ============================================================
// Specification concreta de ejemplo
// ============================================================

export class Active$EntityName$Spec implements Specification<$EntityName$> {
  isSatisfiedBy(entity: $EntityName$): boolean {
    return entity.isActive;
  }
  toQueryParams(): Record<string, unknown> {
    return { isActive: true };
  }
}

export class $EntityName$ByNameSpec implements Specification<$EntityName$> {
  constructor(private readonly name: string) {}

  isSatisfiedBy(entity: $EntityName$): boolean {
    return entity.name.toLowerCase().includes(this.name.toLowerCase());
  }
  toQueryParams(): Record<string, unknown> {
    return { search: this.name };
  }
}

// ============================================================
// Implementación HTTP del repositorio
// ============================================================

export class $EntityName$Repository implements IRepository<$EntityName$> {
  private readonly baseUrl: string;

  constructor(baseUrl: string = '/api/$EntityName$s') {
    this.baseUrl = baseUrl;
  }

  private async http<T>(
    path: string,
    init: RequestInit = {}
  ): Promise<Result<T>> {
    try {
      const res = await fetch(`${this.baseUrl}${path}`, {
        headers: { 'Content-Type': 'application/json' },
        ...init,
      });
      if (!res.ok) {
        const msg = await res.text();
        return Result.fail(new Error(`HTTP ${res.status}: ${msg}`));
      }
      const data: T = await res.json();
      return Result.ok(data);
    } catch (e) {
      return Result.fail(e instanceof Error ? e : new Error(String(e)));
    }
  }

  async findById(id: number): Promise<Result<$EntityName$ | null>> {
    return this.http<$EntityName$ | null>(`/${id}`);
  }

  async findAll(spec?: Specification<$EntityName$>): Promise<Result<$EntityName$[]>> {
    const params = spec ? new URLSearchParams(
      Object.entries(spec.toQueryParams()).map(([k, v]) => [k, String(v)])
    ).toString() : '';
    return this.http<$EntityName$[]>(params ? `?${params}` : '');
  }

  async findPaged(
    page: number,
    pageSize: number,
    spec?: Specification<$EntityName$>
  ): Promise<Result<{ items: $EntityName$[]; total: number }>> {
    const qs = new URLSearchParams({
      page: String(page),
      pageSize: String(pageSize),
      ...(spec?.toQueryParams() as Record<string, string> ?? {}),
    });
    return this.http<{ items: $EntityName$[]; total: number }>(`?${qs}`);
  }

  async create(dto: CreateDto<$EntityName$>): Promise<Result<$EntityName$>> {
    return this.http<$EntityName$>('', { method: 'POST', body: JSON.stringify(dto) });
  }

  async update(id: number, dto: UpdateDto<$EntityName$>): Promise<Result<$EntityName$>> {
    return this.http<$EntityName$>(`/${id}`, { method: 'PUT', body: JSON.stringify(dto) });
  }

  async delete(id: number): Promise<Result<void>> {
    return this.http<void>(`/${id}`, { method: 'DELETE' });
  }

  async exists(id: number): Promise<boolean> {
    const result = await this.findById(id);
    return result.ok && result.value !== null;
  }

  async count(spec?: Specification<$EntityName$>): Promise<number> {
    const result = await this.findAll(spec);
    return result.ok ? result.value.length : 0;
  }
}

// ============================================================
// Unit of Work
// ============================================================

export interface IUnitOfWork {
  $EntityName$s: IRepository<$EntityName$>;
  commit(): Promise<void>;
  rollback(): Promise<void>;
}

export class HttpUnitOfWork implements IUnitOfWork {
  readonly $EntityName$s: $EntityName$Repository;

  constructor() {
    this.$EntityName$s = new $EntityName$Repository();
  }

  async commit(): Promise<void> { /* transacción si aplica */ }
  async rollback(): Promise<void> { /* rollback si aplica */ }
}

// ============================================================
// Uso con Result monad
// ============================================================

// const uow = new HttpUnitOfWork();
