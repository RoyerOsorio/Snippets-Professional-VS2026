<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>TS Generic HTTP Service</Title>
      <Author>VS2026 Snippets Library</Author>
      <Description>Servicio genérico TypeScript con patrón Repository HTTP, manejo de errores, interceptores y tipos seguros.</Description>
      <Shortcut>ts-intermediate-generic-service</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ServiceName</ID>
          <ToolTip>Nombre del servicio (ej: UserService)</ToolTip>
          <Default>UserService</Default>
        </Literal>
        <Literal>
          <ID>ModelName</ID>
          <ToolTip>Nombre del modelo de dominio (ej: User)</ToolTip>
          <Default>User</Default>
        </Literal>
        <Literal>
          <ID>ApiEndpoint</ID>
          <ToolTip>Ruta base del endpoint (ej: users)</ToolTip>
          <Default>users</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript">
        <![CDATA[// ============================================================
// Tipos base reutilizables
// ============================================================

export interface ApiResponse<T> {
  data: T;
  message: string;
  success: boolean;
  statusCode: number;
  timestamp: string;
}

export interface PagedResponse<T> extends ApiResponse<T[]> {
  pagination: {
    page: number;
    pageSize: number;
    totalItems: number;
    totalPages: number;
    hasNext: boolean;
    hasPrevious: boolean;
  };
}

export interface QueryParams {
  page?: number;
  pageSize?: number;
  sortBy?: string;
  sortDirection?: 'asc' | 'desc';
  search?: string;
  [key: string]: unknown;
}

// ============================================================
// Modelo de dominio
// ============================================================

export interface $ModelName$ {
  id: number;
  name: string;
  createdAt: string;
  updatedAt: string;
}

export type Create$ModelName$Dto = Omit<$ModelName$, 'id' | 'createdAt' | 'updatedAt'>;
export type Update$ModelName$Dto = Partial<Create$ModelName$Dto>;

// ============================================================
// Interfaz del repositorio genérico
// ============================================================

export interface IHttpRepository<T, TCreate = Partial<T>, TUpdate = Partial<T>> {
  getAll(params?: QueryParams): Promise<PagedResponse<T>>;
  getById(id: number): Promise<ApiResponse<T>>;
  create(dto: TCreate): Promise<ApiResponse<T>>;
  update(id: number, dto: TUpdate): Promise<ApiResponse<T>>;
  delete(id: number): Promise<ApiResponse<void>>;
}

// ============================================================
// Clase base HTTP genérica
// ============================================================

abstract class BaseHttpService {
  protected readonly baseUrl: string;
  protected readonly defaultHeaders: HeadersInit;

  constructor(baseUrl: string) {
    this.baseUrl = baseUrl;
    this.defaultHeaders = {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
    };
  }

  protected buildUrl(path: string, params?: QueryParams): string {
    const url = new URL(`${this.baseUrl}/${path}`);
    if (params) {
      Object.entries(params).forEach(([key, value]) => {
        if (value !== undefined && value !== null) {
          url.searchParams.append(key, String(value));
        }
      });
    }
    return url.toString();
  }

  protected async request<T>(
    url: string,
    options: RequestInit = {}
  ): Promise<T> {
    const token = this.getAuthToken();
    const headers: HeadersInit = {
      ...this.defaultHeaders,
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...options.headers,
    };

    const response = await fetch(url, { ...options, headers });

    if (!response.ok) {
      await this.handleHttpError(response);
    }

    return response.json() as Promise<T>;
  }

  private getAuthToken(): string | null {
    // Reemplazar con tu implementación de auth (ej: cookie, localStorage, signal)
    return null;
  }

  private async handleHttpError(response: Response): Promise<never> {
    let errorMessage = `HTTP ${response.status}: ${response.statusText}`;
    try {
      const body = await response.json();
      errorMessage = body?.message ?? errorMessage;
    } catch {
      // body no es JSON
    }
    throw new Error(errorMessage);
  }
}

// ============================================================
// Implementación del servicio específico
// ============================================================

export class $ServiceName$
  extends BaseHttpService
  implements IHttpRepository<$ModelName$, Create$ModelName$Dto, Update$ModelName$Dto>
{
  private readonly endpoint = '$ApiEndpoint$';

  constructor(baseUrl: string = '/api') {
    super(baseUrl);
  }

  async getAll(params?: QueryParams): Promise<PagedResponse<$ModelName$>> {
    const url = this.buildUrl(this.endpoint, params);
    return this.request<PagedResponse<$ModelName$>>(url);
  }

  async getById(id: number): Promise<ApiResponse<$ModelName$>> {
    const url = this.buildUrl(`${this.endpoint}/${id}`);
    return this.request<ApiResponse<$ModelName$>>(url);
  }

  async create(dto: Create$ModelName$Dto): Promise<ApiResponse<$ModelName$>> {
    const url = this.buildUrl(this.endpoint);
    return this.request<ApiResponse<$ModelName$>>(url, {
      method: 'POST',
      body: JSON.stringify(dto),
    });
  }

  async update(id: number, dto: Update$ModelName$Dto): Promise<ApiResponse<$ModelName$>> {
    const url = this.buildUrl(`${this.endpoint}/${id}`);
    return this.request<ApiResponse<$ModelName$>>(url, {
      method: 'PUT',
      body: JSON.stringify(dto),
    });
  }

  async delete(id: number): Promise<ApiResponse<void>> {
    const url = this.buildUrl(`${this.endpoint}/${id}`);
    return this.request<ApiResponse<void>>(url, { method: 'DELETE' });
  }
}

// ============================================================
// Uso
// ============================================================

