<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>TypeScript Basic Interface</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Interfaz TypeScript con propiedades opcionales, readonly, tipos union, intersection y utility types</Description>
      <Shortcut>ts-basic-interface</Shortcut>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>InterfaceName</ID><ToolTip>Nombre de la interfaz (PascalCase)</ToolTip><Default>Producto</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript"><![CDATA[// ============================================================
// Interfaz base de la entidad
// ============================================================
export interface $InterfaceName$ {
  readonly id:         number;
  nombre:              string;
  descripcion?:        string;            // Propiedad opcional
  precio:              number;
  categoria:           Categoria;
  tags:                readonly string[]; // Array readonly
  estado:              EstadoItem;
  fechaCreacion:       Date;
  fechaActualizacion?: Date;
  metadata?:           Record<string, unknown>;
}

// Enum como const (mejor rendimiento en runtime)
export const EstadoItem = {
  Activo:   'activo',
  Inactivo: 'inactivo',
  Borrador: 'borrador',
} as const;
export type EstadoItem = typeof EstadoItem[keyof typeof EstadoItem];

// Tipo de referencia anidado
export interface Categoria {
  readonly id:   number;
  nombre:        string;
  slug:          string;
}

// ============================================================
// Utility Types derivados de la interfaz base
// ============================================================

/** DTO de creación: sin id, fechas ni readonly */
export type Create$InterfaceName$Dto = Omit<$InterfaceName$, 'id' | 'fechaCreacion' | 'fechaActualizacion'>;

/** DTO de actualización: todos los campos opcionales excepto id */
export type Update$InterfaceName$Dto = Partial<Omit<$InterfaceName$, 'id' | 'fechaCreacion'>> & { id: number };

/** Vista de listado: solo campos esenciales */
export type $InterfaceName$Summary = Pick<$InterfaceName$, 'id' | 'nombre' | 'precio' | 'estado' | 'categoria'>;

/** Sin metadatos internos para API pública */
export type $InterfaceName$Public = Omit<$InterfaceName$, 'metadata'>;

// ============================================================
// Tipos de respuesta API reutilizables
// ============================================================

export interface ApiResponse<T> {
  data:    T;
  success: boolean;
  message: string;
  errors?: ValidationError[];
}

export interface PagedResponse<T> extends ApiResponse<T[]> {
  totalItems: number;
  page:       number;
  pageSize:   number;
  totalPages: number;
}

export interface ValidationError {
  field:   string;
  message: string;
}

$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
