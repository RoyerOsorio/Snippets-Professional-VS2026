@model DatePickerViewModel
@*
    _DatePicker.cshtml — Componente Date Picker (variante fecha única).
    Origen: Components_Development_Guide_v1.1.md §22.4 / Biblioteca_de_Componentes_v1.0.md §5.
    Contrato: Name (obligatorio), Label (obligatorio), Value (opcional), Required (opcional).
    Se auto-inicializa vía JavaScript_Architecture_Guide_v1.1.md §10.1 sobre [data-component="date-picker"].
*@
<div class="field @Model.WrapperCssClass">
    <label class="field-label" for="@Model.Id">
        @Model.Label
        @if (Model.Required)
        {
            <span class="field-required" aria-hidden="true">*</span>
        }
    </label>
    <div class="date-picker-input-wrap">
        <input type="text"
               id="@Model.Id"
               name="@Model.Name"
               class="form-control date-picker-input"
               value="@Model.Value"
               placeholder="dd/mm/aaaa"
               autocomplete="off"
               data-component="date-picker"
               required="@(Model.Required ? "required" : null)" />
        <i data-lucide="calendar" class="date-picker-icon" aria-hidden="true"></i>
    </div>
</div>
