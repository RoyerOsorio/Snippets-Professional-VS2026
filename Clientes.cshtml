@model IEnumerable<ClienteViewModel>
@{
    ViewData["Title"] = "Clientes";
}

<div class="clientes-view">

    <div class="page-head mt-3">
        <div class="page-head-row">
            <div>
                <h1 class="page-display">Clientes</h1>
                <p class="page-lead">Administra los clientes registrados, sus filiales, módulos y coberturas.</p>
            </div>
            <a href="@Url.Action("CreacionCliente", "Home")" class="btn-primary-vm">
                <i data-lucide="user-plus" aria-hidden="true"></i> Nuevo Cliente
            </a>
        </div>
    </div>

    @* ---------------------------------------------------------------------
       Panel de Filtros — mismo patrón que PagoSolicitud. Filtrado 100% en
       cliente (sin persistencia): clientes-index.js opera sobre las filas
       ya renderizadas por Razor.
       --------------------------------------------------------------------- *@
    <section class="filters-panel" aria-label="Filtros de clientes">
        <div class="filters-panel-head">
            <h2 class="filters-panel-title">
                <i data-lucide="filter" aria-hidden="true"></i>
                Filtros
            </h2>
        </div>

        <form class="filters-form" role="search" id="formFiltrosClientes">
            <div class="filters-row">
                <div class="field">
                    <label for="fBuscar" class="field-label">Nombre, RFC o clave</label>
                    <input type="text" id="fBuscar" class="form-control" placeholder="Buscar cliente">
                </div>
                <div class="field">
                    <label for="fEstado" class="field-label">Estado</label>
                    <select id="fEstado" class="form-select">
                        <option value="todos">Todos</option>
                        <option value="Activo" selected>Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>
            </div>
            <div class="filters-actions">
                <button type="submit" class="btn-primary-vm">
                    <i data-lucide="search" aria-hidden="true"></i> Buscar
                </button>
                <button type="reset" class="btn-text-vm" id="btnLimpiarFiltrosClientes">Limpiar filtros</button>
            </div>
        </form>
    </section>

    @* ---------------------------------------------------------------------
       Tabla de clientes — columnas relevantes de la imagen Grupo.
       --------------------------------------------------------------------- *@
    <section class="table-panel" aria-label="Listado de clientes">
        <div class="table-panel-head">
            <span class="table-count" id="clientesConteo">@Model.Count() resultados</span>
        </div>

        <div class="table-scroll">
            <table class="vm-table" id="tablaClientes">
                <thead>
                    <tr>
                        <th scope="col">Clave</th>
                        <th scope="col">Nombre o razón social</th>
                        <th scope="col">RFC</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Nombre de contacto</th>
                        <th scope="col" class="ta-center">Estado</th>
                        <th scope="col" class="ta-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr data-estado="@c.Estatus" data-busqueda="@($"{c.NombreORazonSocial} {c.Rfc} {c.DescripcionCorta}".ToLowerInvariant())">
                            <td><span class="folio-text">@c.DescripcionCorta</span></td>
                            <td>@c.NombreORazonSocial</td>
                            <td>@c.Rfc</td>
                            <td>@c.Telefono</td>
                            <td>@c.NombreContacto</td>
                            <td class="ta-center">
                                @if (c.Estatus == "Activo")
                                {
                                    <span class="badge-status badge-status--success" data-badge-estado>
                                        <i data-lucide="check-circle" aria-hidden="true"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status--neutral" data-badge-estado>
                                        <i data-lucide="circle-slash" aria-hidden="true"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="ta-center">
                                <div class="row-actions">
                                    <a href="@Url.Action("DetalleCliente", "Home", new { id = c.Id })" class="doc-gen-btn doc-gen-btn--secondary" title="Editar" aria-label="Editar cliente">
                                        <i data-lucide="pencil" aria-hidden="true"></i>
                                    </a>
                                    @if (c.Estatus == "Activo")
                                    {
                                        <button type="button" class="doc-gen-btn doc-gen-btn--danger" data-accion-estado="Desactivar" title="Desactivar" aria-label="Desactivar cliente">
                                            <i data-lucide="ban" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="doc-gen-btn doc-gen-btn--secondary" data-accion-estado="Reactivar" title="Reactivar" aria-label="Reactivar cliente">
                                            <i data-lucide="rotate-ccw" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-panel-foot">
            <span class="table-range">Mostrando @Model.Count() de @Model.Count()</span>
            <nav aria-label="Paginación de clientes">
                <ul class="pagination pagination-vm">
                    <li class="page-item disabled"><a class="page-link" href="#" aria-label="Anterior"><i data-lucide="chevron-left" aria-hidden="true"></i></a></li>
                    <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                    <li class="page-item disabled"><a class="page-link" href="#" aria-label="Siguiente"><i data-lucide="chevron-right" aria-hidden="true"></i></a></li>
                </ul>
            </nav>
        </div>
    </section>
</div>

@* =====================================================================
   Modal · Confirmar Desactivar / Reactivar (Patrón UI-001 CRUD Maestro
   — soft delete, nunca eliminación física)
   ===================================================================== *@
<div class="modal fade" id="modalConfirmarEstadoCliente" tabindex="-1" aria-labelledby="modalConfirmarEstadoClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="modalConfirmarEstadoClienteLabel">
                    <i data-lucide="alert-triangle" aria-hidden="true" style="color:var(--vm-warning-600);width:20px;height:20px;vertical-align:-3px;margin-right:8px"></i>
                    <span id="textoAccionEstado">¿Desactivar este cliente?</span>
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p style="margin:0;color:var(--vm-neutral-900)" id="textoDetalleEstado">Podrás reactivarlo cuando lo necesites.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-text-vm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-outline-danger" id="btnConfirmarEstadoCliente">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/clientes-index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/clientes-index.js" asp-append-version="true"></script>
}
