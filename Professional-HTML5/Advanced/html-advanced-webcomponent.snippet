<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Advanced Web Component</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Web Component nativo con Shadow DOM, atributos observados, eventos personalizados y accesibilidad ARIA</Description>
      <Shortcut>html-advanced-webcomponent</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>componentName</ID>
          <ToolTip>Nombre del elemento personalizado (debe contener guión)</ToolTip>
          <Default>mi-componente</Default>
        </Literal>
        <Literal>
          <ID>ClassName</ID>
          <ToolTip>Nombre de la clase JavaScript (PascalCase)</ToolTip>
          <Default>MiComponente</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Uso del Web Component -->
<$componentName$
  label="Etiqueta del componente"
  value="valor-inicial"
  disabled="false">
</$componentName$>

<script>
/**
 * Web Component: $componentName$
 * Encapsula funcionalidad con Shadow DOM, estilos aislados y ARIA.
 */
class $ClassName$ extends HTMLElement {
  // Atributos que disparan attributeChangedCallback
  static get observedAttributes() {
    return ['label', 'value', 'disabled'];
  }

  constructor() {
    super();
    // Crear Shadow DOM (encapsulación de estilos y estructura)
    this._shadow = this.attachShadow({ mode: 'open' });
    this._render();
  }

  // Ciclo de vida: elemento conectado al DOM
  connectedCallback() {
    this._setupEvents();
    this._updateAria();
  }

  // Ciclo de vida: atributo cambiado
  attributeChangedCallback(name, oldValue, newValue) {
    if (oldValue === newValue) return;
    this._render();
    this._updateAria();
  }

  // Getters / Setters de propiedades
  get value()    { return this.getAttribute('value') ?? ''; }
  set value(v)   { this.setAttribute('value', v); }
  get disabled() { return this.hasAttribute('disabled') && this.getAttribute('disabled') !== 'false'; }
  set disabled(v){ v ? this.setAttribute('disabled', '') : this.removeAttribute('disabled'); }

  // Renderizado del Shadow DOM
  _render() {
    const label    = this.getAttribute('label') ?? 'Campo';
    const value    = this.getAttribute('value') ?? '';
    const disabled = this.disabled;

    this._shadow.innerHTML = `
      <style>
        :host {
          display: block;
          --comp-color: #0d6efd;
          --comp-radius: 0.375rem;
          font-family: system-ui, sans-serif;
        }
        :host([disabled]) { opacity: 0.6; pointer-events: none; }
        .wrapper { display: flex; flex-direction: column; gap: .25rem; }
        label    { font-size: .875rem; font-weight: 600; color: #212529; }
        input    {
          padding: .5rem .75rem;
          border: 1px solid #ced4da;
          border-radius: var(--comp-radius);
          font-size: 1rem;
          transition: border-color 200ms;
          width: 100%;
        }
        input:focus {
          outline: 2px solid var(--comp-color);
          outline-offset: 1px;
          border-color: var(--comp-color);
        }
        .hint { font-size: .75rem; color: #6c757d; }
      </style>
      <div class="wrapper">
        <label for="comp-input" part="label">${label}</label>
        <input  id="comp-input"
                type="text"
                part="input"
                value="${value}"
                ${disabled ? 'disabled aria-disabled="true"' : ''}
                aria-label="${label}" />
        <span class="hint" part="hint">
          <slot name="hint">Ingresa un valor</slot>
        </span>
      </div>
    `;
  }

  // Configurar eventos internos
  _setupEvents() {
    this._shadow.querySelector('input')?.addEventListener('input', (e) => {
      this._value = e.target.value;
      // Emitir evento personalizado al host
      this.dispatchEvent(new CustomEvent('change', {
        detail: { value: e.target.value },
        bubbles: true,
        composed: true  // Atraviesa el Shadow DOM
      }));
    });
  }

  _updateAria() {
    const input = this._shadow.querySelector('input');
    if (input) {
      input.setAttribute('aria-disabled', String(this.disabled));
    }
  }
}

// Registrar el elemento personalizado
if (!customElements.get('$componentName$')) {
  customElements.define('$componentName$', $ClassName$);
}
$end$
</script>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
