<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Advanced Accessibility Layout</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Layout completo de alta accesibilidad: focus management, live regions, skip links, ARIA landmarks y WCAG 2.2 AA</Description>
      <Shortcut>html-advanced-accessibility-layout</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>siteName</ID>
          <ToolTip>Nombre del sitio</ToolTip>
          <Default>Mi Aplicación</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!DOCTYPE html>
<html lang="es" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>$siteName$</title>
  <style>
    /* === ACCESIBILIDAD WCAG 2.2 === */

    /* Skip links (WCAG 2.4.1) */
    .skip-links { position: absolute; top: 0; left: 0; z-index: 9999; }
    .skip-link {
      display: block;
      position: absolute;
      top: -100%;
      left: 1rem;
      padding: .75rem 1.5rem;
      background: #0d6efd;
      color: #fff;
      font-weight: 700;
      border-radius: 0 0 .5rem .5rem;
      text-decoration: none;
      white-space: nowrap;
    }
    .skip-link:focus { top: 0; }

    /* Focus visible mejorado (WCAG 2.4.11) */
    :focus-visible {
      outline: 3px solid #0d6efd;
      outline-offset: 3px;
      border-radius: 2px;
    }
    /* Remover outline solo cuando no es teclado */
    :focus:not(:focus-visible) { outline: none; }

    /* Reducir movimiento (WCAG 2.3.3) */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .001ms !important;
        transition-duration: .001ms !important;
      }
    }

    /* Alto contraste (WCAG 1.4.3) */
    @media (forced-colors: active) {
      .badge { border: 1px solid ButtonText; }
    }

    /* Visually hidden pero accesible a AT */
    .visually-hidden {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0,0,0,0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }
  </style>
</head>
<body>

  <!-- === SKIP LINKS (WCAG 2.4.1) === -->
  <nav class="skip-links" aria-label="Atajos de teclado">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <a class="skip-link" href="#main-nav">Saltar a la navegación</a>
    <a class="skip-link" href="#search">Saltar a la búsqueda</a>
  </nav>

  <!-- === LIVE REGION: Notificaciones globales (WCAG 4.1.3) === -->
  <div role="status"
       id="global-status"
       aria-live="polite"
       aria-atomic="true"
       class="visually-hidden">
    <!-- Las notificaciones se inyectan aquí por JS -->
  </div>
  <div role="alert"
       id="global-alert"
       aria-live="assertive"
       aria-atomic="true"
       class="visually-hidden">
    <!-- Alertas urgentes -->
  </div>

  <!-- === HEADER === -->
  <header role="banner">
    <nav id="main-nav" aria-label="Navegación principal">
      <a href="/" aria-label="$siteName$ - Página de inicio">$siteName$</a>
    </nav>

    <!-- Búsqueda global (WCAG 3.3.2) -->
    <search id="search" aria-label="Búsqueda global">
      <form role="search" action="/buscar" method="get">
        <label for="search-input" class="visually-hidden">Buscar en el sitio</label>
        <input type="search"
               id="search-input"
               name="q"
               placeholder="Buscar..."
               aria-label="Términos de búsqueda"
               autocomplete="off"
               aria-autocomplete="list"
               aria-controls="search-suggestions"
               aria-expanded="false" />
        <ul id="search-suggestions"
            role="listbox"
            aria-label="Sugerencias de búsqueda"
            hidden></ul>
        <button type="submit" aria-label="Ejecutar búsqueda">
          <span aria-hidden="true">🔍</span>
        </button>
      </form>
    </search>
  </header>

  <!-- === MAIN (WCAG 1.3.6) === -->
  <main id="main-content" role="main" tabindex="-1">

    <!-- Mensaje de error global cuando aplique -->
    <div role="alert" class="page-error" hidden>
      <h2>Se produjo un error</h2>
      <p id="error-description"></p>
    </div>

    <!-- Loading state accesible -->
    <div aria-busy="false" id="page-loader" aria-label="Cargando contenido">
      $end$
    </div>

  </main>

  <!-- === FOOTER === -->
  <footer role="contentinfo">
    <nav aria-label="Navegación secundaria">
      <ul>
        <li><a href="/privacidad">Política de Privacidad</a></li>
        <li><a href="/accesibilidad">Declaración de Accesibilidad</a></li>
        <li><a href="/sitemap">Mapa del Sitio</a></li>
      </ul>
    </nav>
    <p>&copy; <time datetime="2026">2026</time> $siteName$</p>
  </footer>

  <script>
    // Gestión de foco al navegar (SPA-friendly)
    function announcePageChange(message) {
      const status = document.getElementById('global-status');
      if (status) { status.textContent = ''; status.textContent = message; }
    }

    function announceAlert(message) {
      const alert = document.getElementById('global-alert');
      if (alert) { alert.textContent = ''; alert.textContent = message; }
    }

    // Focus al main tras carga de página
    document.getElementById('main-content')?.focus();
  </script>
</body>
</html>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
