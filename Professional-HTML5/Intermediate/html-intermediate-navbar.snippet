<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Intermediate Navbar</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Barra de navegación HTML5 semántica, accesible (WCAG), con menú desplegable y ARIA completo</Description>
      <Shortcut>html-intermediate-navbar</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>siteName</ID>
          <ToolTip>Nombre del sitio web</ToolTip>
          <Default>Mi Empresa</Default>
        </Literal>
        <Literal>
          <ID>logoSrc</ID>
          <ToolTip>Ruta del logo</ToolTip>
          <Default>/img/logo.svg</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Navegación principal accesible WCAG 2.2 -->
<header role="banner">
  <nav id="main-nav" aria-label="Navegación principal" class="main-navigation">

    <!-- Logo y nombre del sitio -->
    <a href="/" class="nav-brand" aria-label="$siteName$ - Página de inicio">
      <img src="$logoSrc$"
           alt="Logo de $siteName$"
           width="120" height="40"
           loading="eager" />
    </a>

    <!-- Botón hamburguesa (móvil) -->
    <button type="button"
            class="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-menu"
            aria-label="Abrir menú de navegación">
      <span class="hamburger-bar" aria-hidden="true"></span>
      <span class="hamburger-bar" aria-hidden="true"></span>
      <span class="hamburger-bar" aria-hidden="true"></span>
    </button>

    <!-- Menú de navegación -->
    <ul id="nav-menu" role="list" class="nav-menu">

      <!-- Ítem simple -->
      <li class="nav-item">
        <a href="/" class="nav-link" aria-current="page">Inicio</a>
      </li>

      <!-- Ítem con submenú desplegable -->
      <li class="nav-item nav-item--dropdown">
        <button type="button"
                class="nav-link nav-dropdown-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="dropdown-servicios">
          Servicios
          <span aria-hidden="true" class="dropdown-arrow">▾</span>
        </button>
        <ul id="dropdown-servicios"
            role="menu"
            class="nav-dropdown"
            aria-label="Submenú de Servicios">
          <li role="none">
            <a href="/servicios/web" role="menuitem" class="dropdown-item">Desarrollo Web</a>
          </li>
          <li role="none">
            <a href="/servicios/movil" role="menuitem" class="dropdown-item">Apps Móviles</a>
          </li>
          <li role="none">
            <a href="/servicios/consultoria" role="menuitem" class="dropdown-item">Consultoría</a>
          </li>
        </ul>
      </li>

      <li class="nav-item">
        <a href="/nosotros" class="nav-link">Nosotros</a>
      </li>
      <li class="nav-item">
        <a href="/contacto" class="nav-link">Contacto</a>
      </li>

      <!-- CTA en navegación -->
      <li class="nav-item nav-item--cta">
        <a href="/empezar" class="nav-link nav-cta" aria-label="Comenzar ahora con nuestros servicios">
          Comenzar
        </a>
      </li>
    </ul>

  </nav>
</header>
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
