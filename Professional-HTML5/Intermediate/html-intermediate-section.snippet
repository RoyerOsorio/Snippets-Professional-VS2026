<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Intermediate Section</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Sección HTML5 semántica con article, aside, ARIA landmarks y Schema.org structured data</Description>
      <Shortcut>html-intermediate-section</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>sectionId</ID>
          <ToolTip>ID único de la sección</ToolTip>
          <Default>seccion-principal</Default>
        </Literal>
        <Literal>
          <ID>sectionTitle</ID>
          <ToolTip>Título de la sección</ToolTip>
          <Default>Título de la Sección</Default>
        </Literal>
        <Literal>
          <ID>articleTitle</ID>
          <ToolTip>Título del artículo principal</ToolTip>
          <Default>Título del Artículo</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Sección semántica con estructura WCAG y Schema.org -->
<section id="$sectionId$" aria-labelledby="$sectionId$-heading">
  <h2 id="$sectionId$-heading">$sectionTitle$</h2>

  <div class="content-wrapper">

    <!-- Contenido principal del artículo -->
    <article aria-label="$articleTitle$" itemscope itemtype="https://schema.org/Article">

      <header>
        <h3 itemprop="headline">$articleTitle$</h3>
        <p class="article-meta">
          Publicado por
          <span itemprop="author" itemscope itemtype="https://schema.org/Person">
            <span itemprop="name">Nombre del Autor</span>
          </span>
          el
          <time itemprop="datePublished" datetime="2026-01-15">15 de enero de 2026</time>
        </p>
      </header>

      <!-- Imagen del artículo -->
      <figure>
        <img src="/img/articulo.webp"
             alt="Imagen ilustrativa de $articleTitle$"
             width="800" height="450"
             loading="lazy"
             itemprop="image" />
        <figcaption>Descripción complementaria de la imagen del artículo</figcaption>
      </figure>

      <!-- Cuerpo del artículo -->
      <div itemprop="articleBody">
        <p>$end$</p>
      </div>

      <footer class="article-footer">
        <p>
          Categoría:
          <a href="/categoria/ejemplo" rel="category tag" itemprop="about">Categoría Ejemplo</a>
        </p>
      </footer>
    </article>

    <!-- Barra lateral complementaria -->
    <aside aria-label="Contenido relacionado">
      <section aria-labelledby="related-heading">
        <h3 id="related-heading">Artículos Relacionados</h3>
        <nav aria-label="Artículos relacionados">
          <ul>
            <li><a href="/articulo-1">Artículo relacionado 1</a></li>
            <li><a href="/articulo-2">Artículo relacionado 2</a></li>
            <li><a href="/articulo-3">Artículo relacionado 3</a></li>
          </ul>
        </nav>
      </section>
    </aside>

  </div>
</section>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
