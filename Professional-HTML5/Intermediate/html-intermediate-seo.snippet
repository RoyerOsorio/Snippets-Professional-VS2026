<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Intermediate SEO Schema</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Bloque completo de SEO técnico con Schema.org JSON-LD, breadcrumbs, hreflang y structured data</Description>
      <Shortcut>html-intermediate-seo</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>pageTitle</ID>
          <ToolTip>Título de la página</ToolTip>
          <Default>Título de Página</Default>
        </Literal>
        <Literal>
          <ID>pageUrl</ID>
          <ToolTip>URL absoluta de la página</ToolTip>
          <Default>https://www.miempresa.com/pagina</Default>
        </Literal>
        <Literal>
          <ID>orgName</ID>
          <ToolTip>Nombre de la organización</ToolTip>
          <Default>Mi Empresa S.A. de C.V.</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- === SEO TÉCNICO AVANZADO === -->

<!-- Hreflang para internacionalización -->
<link rel="alternate" hreflang="es" href="$pageUrl$" />
<link rel="alternate" hreflang="es-MX" href="$pageUrl$" />
<link rel="alternate" hreflang="en" href="https://www.miempresa.com/en/page" />
<link rel="alternate" hreflang="x-default" href="$pageUrl$" />

<!-- Breadcrumbs Schema.org JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://www.miempresa.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Sección",
      "item": "https://www.miempresa.com/seccion"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "$pageTitle$",
      "item": "$pageUrl$"
    }
  ]
}
</script>

<!-- Organization Schema.org JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "$orgName$",
  "url": "https://www.miempresa.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://www.miempresa.com/img/logo.png",
    "width": 300,
    "height": 60
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+52-55-1234-5678",
    "contactType": "customer service",
    "areaServed": "MX",
    "availableLanguage": ["Spanish"]
  },
  "sameAs": [
    "https://www.facebook.com/miempresa",
    "https://www.linkedin.com/company/miempresa",
    "https://twitter.com/miempresa"
  ]
}
</script>

<!-- WebPage Schema.org JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "$pageTitle$",
  "url": "$pageUrl$",
  "publisher": {
    "@type": "Organization",
    "name": "$orgName$"
  },
  "inLanguage": "es-MX",
  "dateModified": "2026-01-15T00:00:00+06:00"
}
</script>

<!-- Breadcrumbs HTML visibles (complemento al JSON-LD) -->
<nav aria-label="Ruta de navegación" class="breadcrumbs">
  <ol itemscope itemtype="https://schema.org/BreadcrumbList">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a itemprop="item" href="/">
        <span itemprop="name">Inicio</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
      <span itemprop="name">$pageTitle$</span>
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
