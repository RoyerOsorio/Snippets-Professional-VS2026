<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Intermediate Accessible Table</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Tabla HTML5 accesible con caption, scope, thead/tbody/tfoot y ARIA para lectores de pantalla</Description>
      <Shortcut>html-intermediate-table</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>tableId</ID>
          <ToolTip>ID único de la tabla</ToolTip>
          <Default>data-table</Default>
        </Literal>
        <Literal>
          <ID>tableTitle</ID>
          <ToolTip>Título descriptivo de la tabla</ToolTip>
          <Default>Listado de Productos</Default>
        </Literal>
        <Literal>
          <ID>tableDesc</ID>
          <ToolTip>Descripción ampliada para lectores de pantalla</ToolTip>
          <Default>Tabla con información detallada de productos disponibles.</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Tabla accesible WCAG 2.2 - Criterio 1.3.1 -->
<div class="table-responsive" role="region" aria-labelledby="$tableId$-caption" tabindex="0">
  <table id="$tableId$"
         class="data-table"
         aria-describedby="$tableId$-desc">

    <!-- Título visible e identificador de la tabla -->
    <caption id="$tableId$-caption">
      $tableTitle$
      <span id="$tableId$-desc" class="table-description">
        $tableDesc$
      </span>
    </caption>

    <!-- Encabezados de columna -->
    <thead>
      <tr>
        <th scope="col" aria-sort="none">
          <button type="button" class="sort-btn" aria-label="Ordenar por ID">
            ID <span aria-hidden="true" class="sort-icon">↕</span>
          </button>
        </th>
        <th scope="col" aria-sort="ascending">
          <button type="button" class="sort-btn" aria-label="Ordenar por Nombre, actualmente ascendente">
            Nombre <span aria-hidden="true" class="sort-icon">↑</span>
          </button>
        </th>
        <th scope="col">Categoría</th>
        <th scope="col">Precio</th>
        <th scope="col">Estado</th>
        <th scope="col"><span class="visually-hidden">Acciones</span></th>
      </tr>
    </thead>

    <!-- Cuerpo de datos -->
    <tbody>
      <tr>
        <td data-label="ID">001</td>
        <td data-label="Nombre">Producto Ejemplo A</td>
        <td data-label="Categoría">Electrónica</td>
        <td data-label="Precio">
          <span aria-label="Precio: 299 pesos mexicanos">$299.00</span>
        </td>
        <td data-label="Estado">
          <span class="badge badge--active" aria-label="Estado: Activo">Activo</span>
        </td>
        <td class="table-actions">
          <a href="/productos/001/editar" aria-label="Editar Producto Ejemplo A">Editar</a>
          <button type="button"
                  class="btn-delete"
                  aria-label="Eliminar Producto Ejemplo A"
                  data-confirm="¿Confirmar eliminación?">
            Eliminar
          </button>
        </td>
      </tr>
      $end$
    </tbody>

    <!-- Pie de tabla con totales -->
    <tfoot>
      <tr>
        <th scope="row" colspan="3">Total de productos</th>
        <td><strong>$599.00</strong></td>
        <td colspan="2"></td>
      </tr>
    </tfoot>

  </table>
</div>]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
