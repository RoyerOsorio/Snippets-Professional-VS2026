<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Accessible Image</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Imagen HTML5 accesible con picture, srcset, lazy loading, WebP y texto alternativo WCAG 2.2</Description>
      <Shortcut>html-basic-image-accessible</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>imgSrc</ID>
          <ToolTip>Ruta de la imagen JPEG/PNG de respaldo</ToolTip>
          <Default>/img/imagen.jpg</Default>
        </Literal>
        <Literal>
          <ID>imgWebP</ID>
          <ToolTip>Ruta de la imagen en formato WebP</ToolTip>
          <Default>/img/imagen.webp</Default>
        </Literal>
        <Literal>
          <ID>imgAlt</ID>
          <ToolTip>Texto alternativo descriptivo (no empezar con "imagen de")</ToolTip>
          <Default>Descripción concreta del contenido visual</Default>
        </Literal>
        <Literal>
          <ID>imgWidth</ID>
          <ToolTip>Ancho intrínseco en píxeles (evita CLS)</ToolTip>
          <Default>800</Default>
        </Literal>
        <Literal>
          <ID>imgHeight</ID>
          <ToolTip>Alto intrínseco en píxeles (evita CLS)</ToolTip>
          <Default>450</Default>
        </Literal>
        <Literal>
          <ID>caption</ID>
          <ToolTip>Texto del pie de imagen (vacío si no aplica)</ToolTip>
          <Default>Descripción complementaria de la imagen</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- Imagen accesible con formatos modernos y rendimiento optimizado -->
<figure role="img" aria-labelledby="fig-caption-1">
  <picture>
    <!-- WebP para navegadores modernos (mejor compresión) -->
    <source
      type="image/webp"
      srcset="$imgWebP$ 1x, $imgWebP$ 2x"
      sizes="(max-width: 600px) 100vw, 800px" />

    <!-- JPEG/PNG como respaldo -->
    <source
      type="image/jpeg"
      srcset="$imgSrc$ 1x, $imgSrc$ 2x"
      sizes="(max-width: 600px) 100vw, 800px" />

    <!-- Imagen principal con atributos de accesibilidad y rendimiento -->
    <img
      src="$imgSrc$"
      alt="$imgAlt$"
      width="$imgWidth$"
      height="$imgHeight$"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
      class="img-responsive" />
  </picture>

  <!-- Pie de imagen (WCAG 1.1.1) -->
  <figcaption id="fig-caption-1">$caption$</figcaption>
</figure>
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
