<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>HTML5 Basic Meta Tags</Title>
      <Author>VS2026 Professional Snippets</Author>
      <Description>Conjunto completo de meta tags SEO, redes sociales y rendimiento web</Description>
      <Shortcut>html-basic-meta</Shortcut>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>title</ID>
          <ToolTip>Título de la página</ToolTip>
          <Default>Título de la Página</Default>
        </Literal>
        <Literal>
          <ID>description</ID>
          <ToolTip>Descripción SEO</ToolTip>
          <Default>Descripción de la página.</Default>
        </Literal>
        <Literal>
          <ID>keywords</ID>
          <ToolTip>Palabras clave separadas por comas</ToolTip>
          <Default>palabra1, palabra2, palabra3</Default>
        </Literal>
        <Literal>
          <ID>author</ID>
          <ToolTip>Autor o empresa</ToolTip>
          <Default>Mi Empresa</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!-- === META TAGS COMPLETOS === -->

<!-- SEO Fundamental -->
<meta name="description" content="$description$" />
<meta name="keywords" content="$keywords$" />
<meta name="author" content="$author$" />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Internacionalización -->
<meta http-equiv="content-language" content="es" />

<!-- Open Graph (Facebook, LinkedIn) -->
<meta property="og:type" content="website" />
<meta property="og:title" content="$title$" />
<meta property="og:description" content="$description$" />
<meta property="og:image" content="https://www.miempresa.com/img/og-1200x630.jpg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Imagen representativa de $title$" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="$author$" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@miempresa" />
<meta name="twitter:creator" content="@miempresa" />
<meta name="twitter:title" content="$title$" />
<meta name="twitter:description" content="$description$" />
<meta name="twitter:image" content="https://www.miempresa.com/img/twitter-1200x628.jpg" />
<meta name="twitter:image:alt" content="Imagen de $title$" />

<!-- Seguridad y rendimiento -->
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
$end$]]>
      </Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
